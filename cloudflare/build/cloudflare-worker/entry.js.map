{"/index.html": {"text": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#111311\">\n  <title>Contra \u00b7 Field console</title>\n  <link rel=\"icon\" href=\"data:,\">\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script type=\"module\" src=\"app.js\"></script>\n</head>\n<body>\n  <main>\n    <header><a class=\"wordmark\" href=\"/\">C<span>\u2197</span> FIELD CONSOLE</a><span class=\"edition\">NES / 1988 <i>\u2022</i> US EDITION</span></header>\n    <section class=\"intro\"><div><p class=\"eyebrow\">OPERATION 01 / REASSEMBLED</p><h1>CONTRA<span>\u00ae</span></h1><p class=\"subtitle\">Up to four commandos. One shared mission.</p></div><div class=\"stamp\">LOCAL PLAY<br><strong>NO QUARTERS<br>REQUIRED.</strong></div></section>\n    <label class=\"invite-label mode-select\">Players (local or online)<select id=\"player-count\"><option value=\"2\">Original / 1\u20132 players</option><option value=\"3\">3-player squad (experimental)</option><option value=\"4\">4-player squad (experimental)</option></select></label>\n    <section class=\"net-panel\" aria-label=\"Online co-op\">\n      <div><p class=\"eyebrow\">ONLINE CO-OP / UP TO FOUR PLAYERS</p><p id=\"net-status\" role=\"status\">Load your ROM, then create a room or open an invitation.</p></div>\n      <label class=\"invite-label\">Connection<select id=\"net-transport\"><option value=\"auto\">Automatic (direct, then server relay)</option><option value=\"relay\">Server relay (works through firewalls)</option></select></label>\n      <div class=\"net-buttons\"><button id=\"host-room\" disabled>Create room</button><button id=\"ready-room\" disabled>Ready</button><button id=\"leave-room\" disabled>Leave room</button></div>\n      <label class=\"invite-label\">Invitation link<input id=\"invite\" type=\"text\" placeholder=\"Paste your partner\u2019s invitation link\" autocomplete=\"off\" spellcheck=\"false\"></label>\n      <div class=\"net-buttons\"><button id=\"join-room\" disabled>Join invitation</button><button id=\"copy-invite\" disabled>Copy invitation</button><span id=\"net-detail\">Every browser verifies the same US cartridge.</span></div>\n      <p class=\"net-help\">The room link must use the same reachable server. For internet play, host this app at an HTTPS address and automatic server relay is available when direct connections fail. For subnet testing, start with --lan-address and share that IP address. Localhost links work only on this computer. Three- and four-player squads use the server relay.</p>\n      <details><summary>Connection details</summary><pre id=\"net-diagnostics\">No connection yet.</pre></details>\n    </section>\n    <section class=\"console\" aria-label=\"Game console\">\n      <div class=\"console-bar\"><span><b class=\"led\" id=\"led\"></b><span id=\"state\">STANDBY</span></span><span id=\"fps\">256 \u00d7 240 / NTSC</span></div>\n      <div id=\"screen\" tabindex=\"0\" aria-label=\"Contra game screen. Arrow keys move, Z fires, X jumps, Enter starts.\">\n        <canvas id=\"canvas\" width=\"256\" height=\"240\" aria-label=\"NES video output\"></canvas>\n        <div id=\"overlay\"><p class=\"eyebrow\">READY WHEN YOU ARE</p><h2 id=\"overlay-title\">Your next mission<br>starts here.</h2><p id=\"message\" role=\"status\">Checking for a rebuilt cartridge\u2026</p><button id=\"play\" disabled>PLAY CONTRA <span>\u2197</span></button></div>\n      </div>\n      <div id=\"squad\" class=\"squad\" hidden><span id=\"player-status-1\"></span><span id=\"player-status-2\"></span><span id=\"player-status-3\"></span><span id=\"player-status-4\"></span></div>\n      <div class=\"toolbar\"><div><button id=\"pause\" disabled>Pause</button><button id=\"reset\" disabled>Reset</button></div><div><button id=\"mute\" aria-pressed=\"false\">Sound on</button><button id=\"fullscreen\">Fullscreen \u2197</button></div></div>\n    </section>\n    <section class=\"touch\" aria-label=\"Touch controller\"><div class=\"dpad\"><button data-key=\"ArrowUp\" aria-label=\"Move up\">\u2191</button><button data-key=\"ArrowLeft\" aria-label=\"Move left\">\u2190</button><button data-key=\"ArrowDown\" aria-label=\"Move down\">\u2193</button><button data-key=\"ArrowRight\" aria-label=\"Move right\">\u2192</button></div><div class=\"middle\"><button data-key=\"ShiftRight\">SELECT</button><button data-key=\"Enter\">START</button></div><div class=\"actions\"><button data-key=\"KeyZ\">B<span>FIRE</span></button><button data-key=\"KeyX\">A<span>JUMP</span></button></div></section>\n    <section class=\"briefing\"><div><p class=\"eyebrow\">KNOW YOUR CONTROLS</p><h2>Go in prepared.</h2></div><div class=\"controls\"><p><kbd>\u2191</kbd><kbd>\u2190</kbd><kbd>\u2193</kbd><kbd>\u2192</kbd><span>Move / aim</span></p><p><kbd>Z</kbd><span>Fire</span><kbd>X</kbd><span>Jump</span></p><p><kbd>Enter</kbd><span>Start / in-game pause</span></p><p><kbd>Shift</kbd><span>Select / switch to 2 players</span></p></div><p class=\"controller-note\">Gamepad ready.<br><span>Standard USB & Bluetooth controllers. Player 2: WASD, G fire, H jump. Player 3: IJKL, N fire, M jump. Player 4: numpad 8/4/5/6, 0 fire, decimal jump. Online: everyone uses arrows/Z/X for their assigned player.</span></p></section>\n    <footer><div><span class=\"verified\">\u25c8</span><span id=\"provenance\">Local cartridge \u00b7 source verified</span></div><label class=\"load\">Load original US ROM<input id=\"rom\" type=\"file\" accept=\".nes\" aria-label=\"Load original Contra US ROM\"></label></footer>\n  </main>\n</body>\n</html>\n", "type": "text/html; charset=utf-8"}, "/style.css": {"text": ":root{color-scheme:dark;font-family:Arial,Helvetica,sans-serif;background:#111311;color:#e7e9de;--muted:#858c7c;--orange:#ef7349;--green:#b7c595}*{box-sizing:border-box}body{margin:0}main{width:min(1040px,92%);margin:0 auto}header{height:90px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #30352b}.wordmark{font-size:12px;letter-spacing:2px;color:#d7ddcb;text-decoration:none;font-weight:700}.wordmark span{color:var(--orange);margin:0 14px 0 4px}.edition{font:10px monospace;letter-spacing:1px;color:var(--muted)}.edition i{color:var(--orange);margin:0 10px}.intro{display:flex;justify-content:space-between;align-items:center;padding:44px 0 34px}.eyebrow{color:var(--orange);font:10px monospace;letter-spacing:2px;margin:0 0 18px}h1{font-family:Impact,'Arial Black',sans-serif;font-size:clamp(62px,10vw,108px);font-style:italic;letter-spacing:-2px;line-height:.95;margin:0}h1 span{vertical-align:top;font:18px Arial;margin-left:8px}.subtitle{color:#9ca38e;font-size:14px;margin:20px 0 0}.stamp{font:9px monospace;letter-spacing:1px;line-height:1.8;border-left:2px solid var(--orange);padding:8px 0 8px 20px;color:var(--muted)}.stamp strong{display:block;margin-top:10px;color:#c8cebb;font-size:13px;line-height:1.4}.console{border:1px solid #3a4133;background:#181c16;box-shadow:0 20px 70px #0005}.console-bar{height:41px;border-bottom:1px solid #333a2c;display:flex;justify-content:space-between;align-items:center;padding:0 20px;font:10px monospace;letter-spacing:1px;color:var(--muted)}.led{display:inline-block;width:6px;height:6px;border-radius:50%;background:#69715e;margin-right:9px}.led.live{background:var(--green);box-shadow:0 0 10px #b7c59566}#screen{height:min(64vh,640px);min-height:280px;position:relative;display:flex;align-items:center;justify-content:center;background:#050705;outline:none}canvas{height:100%;width:auto;max-width:100%;object-fit:contain;image-rendering:pixelated}#overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:radial-gradient(ellipse at center,#222b1d 0%,#0d110c 65%);padding:20px}#overlay[hidden]{display:none}#overlay h2{font-size:clamp(24px,4vw,43px);line-height:1.15;letter-spacing:-1px;margin:0 0 18px}#message{max-width:430px;color:#9ca58e;font-size:13px;line-height:1.6;margin:0 0 26px}button{cursor:pointer;font:inherit}button:disabled{cursor:default;opacity:.4}#play{background:var(--orange);border:0;color:#13170f;padding:16px 24px;min-width:210px;font-size:11px;font-weight:700;letter-spacing:1px}#play span{margin-left:40px}button:hover:not(:disabled){filter:brightness(1.2)}button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--orange);outline-offset:4px}.toolbar{display:flex;justify-content:space-between;padding:10px 14px;border-top:1px solid #333a2c}.toolbar button{background:transparent;border:0;color:#a8b098;font-size:11px;padding:10px}.briefing{display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:30px;padding:36px 0}.briefing h2{margin:0;font-size:23px;letter-spacing:-.5px}.briefing .eyebrow{color:var(--muted);font-size:9px}.controls p{display:flex;align-items:center;gap:5px;font-size:11px;margin:0 0 10px}.controls span{color:#9ca38e;margin:0 10px}kbd{border:1px solid #3e4636;border-bottom-width:2px;min-width:23px;padding:5px;text-align:center;font:10px monospace;border-radius:3px}.controller-note{margin:0;font-size:12px;line-height:1.7;color:var(--green)}.controller-note span{font-size:11px;color:var(--muted)}footer{border-top:1px solid #30352b;padding:23px 0 30px;display:flex;align-items:center;justify-content:space-between;font:10px monospace;color:var(--muted);gap:16px}.verified{color:var(--green);margin-right:8px}.load{cursor:pointer;color:#b7c595;text-decoration:underline;text-underline-offset:4px;position:relative;white-space:nowrap}.load input{position:absolute;inset:0;opacity:0;width:100%;cursor:pointer}.touch{display:none;justify-content:space-between;align-items:center;padding:25px 4px;gap:12px}.touch button{touch-action:none;user-select:none;-webkit-user-select:none;border:1px solid #424a38;background:#22291e;color:#c6d1b3;border-radius:6px;min-height:46px;min-width:46px}.dpad{display:grid;grid-template-columns:repeat(3,42px);gap:4px}.dpad button{min-width:42px}.dpad button:first-child{grid-column:2}.dpad button:nth-child(2){grid-column:1}.middle{display:flex;gap:6px}.middle button{font:8px monospace;min-width:44px}.actions{display:flex;gap:8px}.actions button{background:#aa4d31;border-radius:50%;width:52px;height:52px;font-weight:bold}.actions span{display:block;font:8px monospace;margin-top:4px}#screen:fullscreen{height:100vh;background:#000}#screen:fullscreen canvas{max-width:100vw;max-height:100vh}@media(pointer:coarse){.touch{display:flex}}@media(max-width:700px){header{height:65px}.edition{font-size:8px}.stamp{display:none}.intro{padding:30px 0}#screen{height:auto;aspect-ratio:256/240;min-height:0}.briefing{grid-template-columns:1fr;gap:22px}.controller-note{display:none}.touch{display:flex}.toolbar{padding:6px}footer{font-size:9px;align-items:flex-start}footer>div{max-width:55%}.eyebrow{font-size:9px}#overlay .eyebrow{display:none}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}\n\n.net-panel{margin:0 0 24px;padding:22px;border:1px solid #3a4133;background:#181c16;display:grid;gap:14px}.net-panel .eyebrow{margin-bottom:10px}.net-panel p{margin:0;color:#a8b098;font-size:12px;line-height:1.6}.net-buttons{display:flex;flex-wrap:wrap;align-items:center;gap:10px}.net-buttons button{padding:10px 16px;border:1px solid #566047;background:#252e1e;color:#d1ddbf;font-size:12px}.invite-label{font-size:11px;color:#a8b098;display:grid;gap:8px}.invite-label input{width:100%;padding:12px;background:#10150d;border:1px solid #3a4133;color:#d1ddbf;font:12px monospace}#net-detail{font:10px monospace;color:#b7c595}.net-panel .net-help{font-size:10px;color:#858c7c}.net-panel[hidden]{display:none}\n\n.net-panel details{font:10px monospace;color:#9ca38e}.net-panel summary{cursor:pointer}#net-diagnostics{white-space:pre-wrap;line-height:1.6;max-height:180px;overflow:auto}\n\n.invite-label select{padding:10px;background:#10150d;border:1px solid #3a4133;color:#d1ddbf;font:12px Arial}\n\n.mode-select{display:block;margin:0 0 20px;max-width:420px}.squad{display:flex;flex-wrap:wrap;gap:12px;padding:12px 18px;background:#111;font:12px monospace}.squad[hidden]{display:none}.squad span:nth-child(1){color:#879fff}.squad span:nth-child(2){color:#ff867e}.squad span:nth-child(3){color:#70dc68}.squad span:nth-child(4){color:#f4d052}\n", "type": "text/css; charset=utf-8"}, "/app.js": {"text": "import {FourPlayer} from './gameplay/four-player.mjs';\nimport {prepareTwoPlayerGame} from './netplay/game.mjs';\nimport {digestHex} from './netplay/digest.mjs';\nimport {DirectRoom} from './netplay/direct-room.mjs';\nimport {PartyRoom} from './netplay/party-room.mjs';\nimport NES from './vendor/jsnes/src/nes.js';\nimport {Room} from './netplay/room.mjs';\nimport {GameSession} from './netplay/game-session.mjs';\n\nconst EXPECTED = '1c747c78c678f14a68d4e5fcae065298a103f833638775860f0e5c5ffaa061f62d45fd8942148b1507c1fd57fde950a5d83f9f84a9782ec048a56067740c48e9';\nconst $ = (id) => document.getElementById(id);\nconst canvas = $('canvas');\nconst ctx = canvas.getContext('2d', {alpha:false});\nconst image = ctx.createImageData(256, 240);\nconst pixels = new Uint32Array(image.data.buffer);\nconst keys = new Map([\n  ['KeyX',[1,0]],['KeyZ',[1,1]],['ShiftRight',[1,2]],['ShiftLeft',[1,2]],['Enter',[1,3]],\n  ['ArrowUp',[1,4]],['ArrowDown',[1,5]],['ArrowLeft',[1,6]],['ArrowRight',[1,7]],\n  ['KeyH',[2,0]],['KeyG',[2,1]],['KeyR',[2,2]],['KeyT',[2,3]],\n  ['KeyM',[3,0]],['KeyN',[3,1]],['KeyI',[3,4]],['KeyK',[3,5]],['KeyJ',[3,6]],['KeyL',[3,7]],\n  ['NumpadDecimal',[4,0]],['Numpad0',[4,1]],['Numpad8',[4,4]],['Numpad5',[4,5]],['Numpad4',[4,6]],['Numpad6',[4,7]],\n  ['KeyW',[2,4]],['KeyS',[2,5]],['KeyA',[2,6]],['KeyD',[2,7]],\n]);\nlet rom = null, running = false, starting = false, muted = false;\nlet audio = null, node = null, gain = null, raf = 0, previous = 0, accumulator = 0;\nlet sampleCount = 0, frames = 0, fpsTime = 0;\nconst sampleL = new Float32Array(2048), sampleR = new Float32Array(2048);\nconst inputs = new Map();\nconst taps = new Set();\nlet room=null, netgame=null;\nlet deployment={directOnly:false};\nlet networkTimer=null;\nconst nes = new NES({\n  sampleRate:48000,\n  onFrame(buffer) { for (let i=0;i<pixels.length;i++) pixels[i] = 0xff000000 | buffer[i]; },\n  onAudioSample(left, right) {\n    if (node && running && !muted && sampleCount < sampleL.length) {\n      sampleL[sampleCount] = left; sampleR[sampleCount++] = right;\n    }\n  },\n});\nfunction input(source, player, button, down) {\n  if(room)player=room.player || 1;\n  const id = `${player}:${button}`;\n  if (!inputs.has(id)) inputs.set(id, new Set());\n  const held = inputs.get(id);\n  down ? held.add(source) : held.delete(source);\n  if (down && running) taps.add(id);\n  if (rom && !room && nes.controllers[player]) nes[(held.size || taps.has(id)) && running ? 'buttonDown' : 'buttonUp'](player,button);\n}\nfunction release() {\n  inputs.clear(); taps.clear();\n  if(nes.fourPlayer)nes.fourPlayer.setInputs(Array(nes.fourPlayer.count).fill(0));\n  if(!room)for(let p=1;p<=2;p++) for(let b=0;b<8;b++) nes.buttonUp(p,b);\n}\nfunction clearAudio() { sampleCount = 0; node?.port.postMessage('clear'); }\nfunction showState(text) { $('state').textContent=text; $('led').classList.toggle('live',running); }\nfunction pause() {\n  if(room?.started){requestCommand(\"pause\");return;}\n  stopLocal();\n}\nfunction stopLocal() {\n  running=false; cancelAnimationFrame(raf); release(); clearAudio();\n  if (audio?.state==='running') audio.suspend().catch(console.warn);\n  $('pause').textContent='Resume'; $('play').textContent='RESUME MISSION \u2197';\n  $('overlay-title').textContent='Mission paused.'; $('message').textContent='Take a breath. Resume when you\u2019re ready.';\n  $('overlay').hidden=false; showState('PAUSED');\n}\nasync function ensureAudio() {\n  if (!audio) {\n    audio = new AudioContext({sampleRate:48000,latencyHint:'interactive'});\n    const embedded = $('audio-source');\n    const url = embedded ? URL.createObjectURL(new Blob([embedded.textContent], {type:'application/javascript'})) : './audio-worklet.js';\n    if(audio.audioWorklet) {\n      try { await audio.audioWorklet.addModule(url); } finally { if (embedded) URL.revokeObjectURL(url); }\n      node = new AudioWorkletNode(audio,'contra-audio',{outputChannelCount:[2]});\n    } else {\n      if(embedded)URL.revokeObjectURL(url);\n      node=audio.createScriptProcessor(1024,0,2);\n      const left=new Float32Array(8192),right=new Float32Array(8192);let read=0,write=0;\n      node.port={postMessage:data=>{if(data==='clear'){read=write=0;return;}for(let i=0;i<data[0].length;i++){left[write%8192]=data[0][i];right[write%8192]=data[1][i];write++;if(write-read>8192)read=write-8192;}}};\n      node.onaudioprocess=event=>{const l=event.outputBuffer.getChannelData(0),r=event.outputBuffer.getChannelData(1);for(let i=0;i<l.length;i++){const have=read<write;l[i]=have?left[read%8192]:0;r[i]=have?right[read%8192]:0;if(have)read++;}};\n    }\n    gain = audio.createGain(); gain.gain.value=muted?0:0.65;\n    node.connect(gain).connect(audio.destination);\n  }\n  await audio.resume();\n}\nasync function play() {\n  if(room){if(room.started)requestCommand(\"resume\");return;}\n  if (!rom || running || starting) return;\n  starting=true;\n  try { await ensureAudio(); } catch(err) {\n    console.warn('Audio unavailable; playing silently.',err);\n    if(audio) await audio.close().catch(()=>{});\n    audio=null; node=null; gain=null;\n  }\n  starting=false;\n  if (document.hidden) return;\n  running=true; previous=0; accumulator=0; frames=0; fpsTime=0;\n  $('overlay').hidden=true; $('pause').textContent='Pause'; showState('MISSION ACTIVE');\n  $('screen').focus({preventScroll:true}); raf=requestAnimationFrame(tick);\n}\nfunction gamepads() {\n  const pads = navigator.getGamepads?.() || [];\n  const connected = Array.from(pads).filter(p=>p?.mapping==='standard').slice(0,Number($('player-count').value));\n  for(let p=1;p<=(room?1:Number($('player-count').value));p++) {\n    const pad=connected[p-1];\n    const pressed = i=>!!pad?.buttons[i]?.pressed;\n    const state=[pressed(0),pressed(1)||pressed(2),pressed(8),pressed(9),\n      pressed(12)||(pad?.axes[1]<-0.4),pressed(13)||(pad?.axes[1]>0.4),\n      pressed(14)||(pad?.axes[0]<-0.4),pressed(15)||(pad?.axes[0]>0.4)];\n    for(let b=0;b<8;b++) input('gamepad',p,b,!!state[b]);\n  }\n}\nfunction tick(now, fromTimer=false) {\n  if(!running) return;\n  const interval=1000/60.0988;\n  if(!previous) { previous=now; fpsTime=now; }\n  accumulator += Math.min(now-previous,interval*3); previous=now;\n  gamepads();\n  try {\n    while(accumulator>=interval) {\n      if(room?.started) {\n        if(!room.connected){room.fail(new Error('Peer disconnected'));return;}\n        let mask=0;\n        for(let b=0;b<8;b++){const id=`${room.player}:${b}`;if(inputs.get(id)?.size||taps.has(id))mask|=1<<b;}\n        const result=netgame.step(mask);\n        if(result.scheduled)taps.clear();\n        if(!result.advanced){accumulator=Math.min(accumulator,interval);if(result.state==='waiting')showState('WAITING FOR SQUAD');clearAudio();break;}\n        showState(`CO-OP / PLAYER ${room.player}`);\n      } else {\n        if(nes.fourPlayer)nes.fourPlayer.setInputs(Array.from({length:nes.fourPlayer.count},(_,p)=>{let mask=0;for(let b=0;b<8;b++)if(inputs.get(`${p+1}:${b}`)?.size||taps.has(`${p+1}:${b}`))mask|=1<<b;return mask;}));\n        nes.frame();\n      }\n      frames++;accumulator-=interval;\n      if(!room)taps.clear();\n      if(!room)for (const [id, held] of inputs) {\n        const [p,b]=id.split(':').map(Number);\n        if(nes.controllers[p])nes[held.size ? 'buttonDown' : 'buttonUp'](p,b);\n      }\n      if(sampleCount) {\n        const l=sampleL.slice(0,sampleCount),r=sampleR.slice(0,sampleCount);\n        node.port.postMessage([l,r],[l.buffer,r.buffer]); sampleCount=0;\n      }\n    }\n    ctx.putImageData(image,0,0);updateSquad();\n  } catch(err) { if(room){room.fail(err);return;}pause(); $('message').textContent=`Emulation stopped: ${err.message}`; return; }\n  if(now-fpsTime>=1000) {\n    $('fps').textContent=`${Math.round(frames*1000/(now-fpsTime))} FPS / NTSC`;\n    frames=0;fpsTime=now;\n  }\n  if(!fromTimer)raf=requestAnimationFrame(tick);\n}\nasync function load(buffer, rebuilt=false, peer=false) {\n  const bytes=new Uint8Array(buffer);\n  if(bytes.length!==131088 || ![0x4e,0x45,0x53,0x1a,8,0,0x21,0,0,0,0,0,0,0,0,0].every((v,i)=>bytes[i]===v))\n    throw new Error('Choose the original 131,088-byte Contra (US) iNES ROM.');\n  const hash=await digestHex('SHA-512',bytes);\n  if(hash!==EXPECTED) throw new Error('ROM hash mismatch. This cartridge is not the expected original Contra (US).');\n  if(running) pause();\n  if(room && !(peer && !room.started && room.player!==1))throw new Error('Leave the room before changing cartridges.');\n  rom=Array.from(bytes,b=>String.fromCharCode(b)).join('');\n  resetLocalGame(); release(); clearAudio();\n  $('play').disabled=false; $('pause').disabled=false; $('reset').disabled=false;\n  $('play').textContent='PLAY CONTRA \u2197'; $('overlay-title').innerText='Your next mission\\nstarts here.';\n  $('message').textContent=rebuilt?'Reassembled from source. Byte-for-byte verified. Press Play, then Enter to start.':'Original US cartridge verified. Press Play, then Enter to start.';\n  $('provenance').textContent=rebuilt?'Rebuilt cartridge \u00b7 SHA-512 verified':'Original cartridge \u00b7 SHA-512 verified';\n  $('overlay').hidden=false; showState('CARTRIDGE VERIFIED'); updateRoomButtons();\n}\n$('play').addEventListener('click',play);\n$('pause').addEventListener('click',()=>room?.started?requestCommand(netgame.paused?'resume':'pause'):running?pause():play());\n$('reset').addEventListener('click',()=>{\n  if(room){if(room.started)requestCommand('reset');return;}\n  if(!rom) return;\n  const wasRunning=running;\n  if(wasRunning) pause();\n  resetLocalGame(); release(); clearAudio();\n  if(wasRunning) play();\n  else { $('overlay-title').textContent='Fresh start.'; $('message').textContent='Cartridge reset. Resume to begin again.'; }\n});\n$('mute').addEventListener('click',()=>{\n  muted=!muted; clearAudio(); if(gain) gain.gain.value=muted?0:0.65;\n  $('mute').textContent=muted?'Sound off':'Sound on'; $('mute').setAttribute('aria-pressed',String(muted));\n});\n$('fullscreen').addEventListener('click',async()=>{\n  try { document.fullscreenElement?await document.exitFullscreen():await $('screen').requestFullscreen(); }\n  catch(err) { $('provenance').textContent='Fullscreen unavailable in this browser'; }\n});\nfor(const type of ['keydown','keyup']) document.addEventListener(type,e=>{\n  if(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLButtonElement || e.ctrlKey || e.metaKey || e.altKey) return;\n  if(e.code==='KeyP' && type==='keydown' && !e.repeat && rom) {room?.started?requestCommand(netgame.paused?'resume':'pause'):running?pause():play();return;}\n  const key=keys.get(e.code); if(!key || !running) return;\n  e.preventDefault(); input(e.code,...key,type==='keydown');\n});\nfor(const button of document.querySelectorAll('[data-key]')) {\n  button.addEventListener('pointerdown',e=>{\n    e.preventDefault(); button.setPointerCapture(e.pointerId);\n    if(running) input(`touch:${e.pointerId}`,...keys.get(button.dataset.key),true);\n  });\n  for(const type of ['pointerup','pointercancel','lostpointercapture']) button.addEventListener(type,e=>{\n    input(`touch:${e.pointerId}`,...keys.get(button.dataset.key),false);\n  });\n}\nwindow.addEventListener('blur',()=>{release();if(running&&!room)pause();});\ndocument.addEventListener('visibilitychange',()=>{release();if(document.hidden&&running&&!room)pause();});\n$('rom').addEventListener('change',async e=>{\n  const file=e.target.files[0]; if(!file) return;\n  try { if(file.size!==131088) throw new Error('Incorrect ROM size. Choose the original Contra (US) .nes file.'); await load(await file.arrayBuffer()); }\n  catch(err) { $('provenance').textContent=err.message; }\n  e.target.value='';\n});\n\n\nfunction resetLocalGame() {\n  nes.fourPlayer?.dispose();\n  const count=Number($('player-count').value);\n  if(count>2){prepareTwoPlayerGame(nes,rom);new FourPlayer(nes,count);}\n  else nes.loadROM(rom);\n  updateSquad();\n}\nfunction updateSquad() {\n  $('squad').hidden=!nes.fourPlayer;\n  if(!nes.fourPlayer)return;\n  const m=nes.cpu.mem,status=[{player:1,lives:m[0x32],gameOver:m[0x38],weapon:m[0xaa]},{player:2,lives:m[0x33],gameOver:m[0x39],weapon:m[0xab]},...nes.fourPlayer.status];\n  for(let i=1;i<=4;i++) {\n    const p=status.find(p=>p.player===i),element=$(`player-status-${i}`);element.hidden=!p;\n    if(p)element.textContent=`P${i} \u00b7 ${p.gameOver?'OUT':`${p.lives+1} lives \u00b7 ${['Rifle','Machine gun','Flame','Spread','Laser'][p.weapon&7]||'Rifle'}`}`;\n  }\n}\n$('player-count').addEventListener('change',()=>{if(!rom||room)return;if(running)stopLocal();resetLocalGame();$('message').textContent=Number($('player-count').value)>2?'Squad ready at stage 1. Resume to start.':'Original cartridge reset. Press Play, then Enter.';});\n\nfunction updateRoomButtons() {\n  $('host-room').disabled=!rom || !!room;\n  $('join-room').disabled=(!rom && !deployment.directOnly) || !!room;\n  $('leave-room').disabled=!room;\n  $('ready-room').disabled=!rom || !room?.connected || room.ready;\n  $('rom').disabled=!!room;$('net-transport').disabled=!!room || deployment.directOnly;$('player-count').disabled=!!room;\n  if(room && !room.started){$('play').disabled=true;$('pause').disabled=true;$('reset').disabled=true;}\n}\nfunction initializeNetwork() {\n  running=false;release();clearAudio();\n  const session=room;\n  netgame=new GameSession({nes,rom,room:room.id,player:room.player,players:room.players||2,send:packet=>session.send(packet),\n    onState:state=>{\n      clearAudio();release();const paused=state==='paused';\n      $('pause').textContent=paused?'Resume':'Pause';$('overlay').hidden=!paused;\n      if(paused){$('overlay-title').textContent='Co-op paused.';$('message').textContent='All players pause at the same frame.';$('play').textContent='RESUME CO-OP \u2197';showState('CO-OP PAUSED');}\n    },\n    onVerified:({frame,hash})=>{\n      $('net-detail').textContent=`Frame ${frame} synchronized \u2022 checksums match`;\n      $('screen').dataset.netFrame=String(frame);$('screen').dataset.netHash=hash;\n    },\n    onFatal:error=>session.fail(error),\n  });\n  netgame.start();\n  running=true;previous=0;accumulator=0;frames=0;fpsTime=0;\n  $('overlay').hidden=true;$('pause').disabled=false;$('reset').disabled=false;$('play').disabled=false;\n  $('pause').textContent='Pause';$('net-status').textContent=`${room.players||2}-player mission active. You are player ${room.player}.`;\n  $('screen').focus({preventScroll:true});\n}\nfunction requestCommand(action){try{netgame?.request(action);}catch(error){room?.fail(error);}}\nfunction endRoom(message='Left room. Local play is available.') {\n  const previousRoom=room;room=null;previousRoom?.close();netgame?.close();netgame=null;\n  clearInterval(networkTimer);networkTimer=null;\n  running=false;cancelAnimationFrame(raf);release();clearAudio();\n  if(rom)resetLocalGame();\n  $('overlay').hidden=false;$('overlay-title').textContent='Ready for your next mission.';\n  $('message').textContent=message;$('net-status').textContent=message;$('play').textContent='PLAY CONTRA \u2197';\n  $('play').disabled=!rom;$('pause').disabled=!rom;$('reset').disabled=!rom;\n  $('pause').textContent='Pause';$('copy-invite').disabled=true;$('net-detail').textContent='Every browser verifies the same US cartridge.';\n  delete $('screen').dataset.netFrame;delete $('screen').dataset.netHash;showState('LOCAL PLAY');updateRoomButtons();\n}\nasync function connectRoom(host) {\n  if(room || (!rom && (host || !deployment.directOnly)))return;\n  if(running)stopLocal();\n  let session;\n  let players=Number($('player-count').value);\n  if(!host){try{players=Number(new URLSearchParams(new URL($('invite').value.trim()).hash.slice(1)).get('players')||2);}catch{}}\n  if(![2,3,4].includes(players)){$('net-status').textContent='Invalid invitation player count';return;}\n  $('player-count').value=String(players);\n  const RoomType=deployment.directOnly?DirectRoom:players>2?PartyRoom:Room;\n  session=new RoomType({players,fingerprint:players>2?`${EXPECTED}:squad-v1:${players}`:EXPECTED,preferRelay:!window.isSecureContext || $('net-transport').value==='relay',\n    getCartridge:()=>rom,\n    onCartridge:async buffer=>{if(room!==session||session.started)throw new Error('Unexpected peer cartridge');await load(buffer,false,true);$('net-detail').textContent='Cartridge received directly from host \u00b7 SHA-512 verified';updateRoomButtons();},\n    onDiagnostic:message=>{if(room===session){const lines=$('net-diagnostics').textContent.split('\\n');lines.push(message);$('net-diagnostics').textContent=lines.slice(-40).join('\\n');}},\n    onStatus:(message,link)=>{if(room!==session)return;$('net-status').textContent=message;if(link){$('invite').value=link;$('copy-invite').disabled=false;}updateRoomButtons();},\n    onStart:()=>{if(room!==session)return;try{initializeNetwork();raf=requestAnimationFrame(tick);networkTimer=setInterval(()=>{if(document.hidden&&running&&room?.started)tick(performance.now(),true);},16);}catch(error){session.fail(error);}},\n    onInput:(packet,player)=>{if(room===session)netgame?.input(packet,player);},\n    onCommand:(packet,request)=>{if(room===session)netgame?.command(packet,request);},\n    onHash:(packet,player)=>{if(room===session)netgame?.hash(packet,player);},\n    onClose:message=>{if(room===session)endRoom(message);},\n    onLatency:ms=>{if(room===session)$('net-status').textContent=`Player ${session.player} \u2022 ${session.relay?'server relay':'direct WebRTC'} \u2022 ${ms} ms round-trip`},\n  });\n  room=session;$('net-diagnostics').textContent='';updateRoomButtons();$('net-status').textContent='Connecting\u2026';\n  try {\n    if(host)await session.host();\n    else {\n      const invitation=new URL($('invite').value.trim());\n      if(invitation.origin!==location.origin || invitation.pathname!==location.pathname)throw new Error('Open the invitation at its original address, then load your ROM and join there.');\n      const params=new URLSearchParams(invitation.hash.slice(1));\n      if(!/^[A-Za-z0-9_-]{24}$/.test(params.get('room')||'') || !/^[A-Za-z0-9_-]{32}$/.test(params.get('invite')||''))throw new Error('Invalid invitation link');\n      await session.join(params.get('room'),params.get('invite'));\n    }\n  } catch(error){if(room===session)session.fail(error);}\n}\n$('host-room').addEventListener('click',()=>connectRoom(true));\n$('join-room').addEventListener('click',()=>connectRoom(false));\n$('leave-room').addEventListener('click',()=>endRoom());\n$('ready-room').addEventListener('click',async()=>{\n  const session=room;\n  if(!rom || !session?.connected)return;\n  try{try{await ensureAudio();}catch(error){console.warn('Audio unavailable; continuing silently',error);node=null;}if(room===session){session.markReady();updateRoomButtons();if(!session.started)$('net-status').textContent='Ready. Waiting for the other players\u2026';}}\n  catch(error){$('net-status').textContent=`Audio could not start: ${error.message}`;}\n});\n$('copy-invite').addEventListener('click',async()=>{\n  try{await navigator.clipboard.writeText($('invite').value);$('net-status').textContent='Invitation copied.';}\n  catch{$('net-status').textContent='Select and copy the invitation link above.';}\n});\nif(location.hash.includes('room=')){const count=new URLSearchParams(location.hash.slice(1)).get('players');if(['2','3','4'].includes(count))$('player-count').value=count;$('invite').value=location.href;$('net-status').textContent='Invitation received. Load your ROM, then click Join invitation.';}\n\ntry {\n  try {\n    const config=$('cartridge')?null:await fetch('/api/config');if(config?.ok)deployment=await config.json();\n    if(deployment.directOnly){$('net-transport').innerHTML='<option value=\"direct\">Direct WebRTC \u00b7 cloud relay disabled</option>';$('net-transport').disabled=true;$('net-status').textContent='Host: load a ROM and create a room. Guests: join the invitation to receive it directly.';updateRoomButtons();}\n  }catch(error){console.warn('Room configuration unavailable',error);}\n  const embedded=$('cartridge');\n  if(embedded) {\n    const bytes=Uint8Array.from(atob(embedded.textContent.trim()),c=>c.charCodeAt(0));\n    await load(bytes.buffer,true);\n  } else {\n  const response=await fetch('./game/manifest.json');\n  if(!response.ok) throw new Error('No rebuilt cartridge yet. Load your original US ROM below, or run the local build first.');\n  const manifest=await response.json();\n  if(manifest.sha512!==EXPECTED || manifest.byteIdentical!==true) throw new Error('Build manifest verification failed. Rebuild the cartridge.');\n  const cartridge=await fetch('./game/contra.nes');\n  if(!cartridge.ok) throw new Error('Rebuilt cartridge missing. Run the local build.');\n  await load(await cartridge.arrayBuffer(),manifest.rebuilt!==false);\n  if(manifest.rebuilt===false){$('net-detail').textContent='Verified cartridge loaded from this LAN server.';$('net-status').textContent=location.hash.includes('room=')?'Server cartridge verified. Click Join invitation.':'Server cartridge verified. Create a room or join an invitation.';}\n  }\n} catch(err) { $('message').textContent=err.message; $('provenance').textContent='Awaiting cartridge'; showState('AWAITING CARTRIDGE'); }\n", "type": "text/javascript; charset=utf-8"}, "/audio-worklet.js": {"text": "// Local AudioWorklet; bounded stereo ring buffer, no dynamic code or network.\nclass ContraAudio extends AudioWorkletProcessor {\n  constructor() {\n    super();\n    this.left = new Float32Array(4096);\n    this.right = new Float32Array(4096);\n    this.read = 0; this.write = 0; this.count = 0;\n    this.port.onmessage = ({data}) => {\n      if (data === 'clear') { this.count = 0; this.read = this.write; return; }\n      const [left, right] = data;\n      for (let i = 0; i < left.length; i++) {\n        if (this.count === 4096) { this.read = (this.read + 1) & 4095; this.count--; }\n        this.left[this.write] = left[i]; this.right[this.write] = right[i];\n        this.write = (this.write + 1) & 4095; this.count++;\n      }\n    };\n  }\n  process(_inputs, outputs) {\n    const [left, right] = outputs[0];\n    for (let i = 0; i < left.length; i++) {\n      if (this.count) {\n        left[i] = this.left[this.read]; right[i] = this.right[this.read];\n        this.read = (this.read + 1) & 4095; this.count--;\n      } else { left[i] = 0; right[i] = 0; }\n    }\n    return true;\n  }\n}\nregisterProcessor('contra-audio', ContraAudio);\n", "type": "text/javascript; charset=utf-8"}, "/netplay/digest.mjs": {"text": "// MIT License \u2014 Copyright (c) 2026 Rick Gerkin.\n// SHA-2 fallback for LAN HTTP, where WebCrypto is unavailable. Constants are\n// the standard fractional square/cube roots of the first prime numbers.\nconst SHA2_H=[0x6a09e667f3bcc908n,0xbb67ae8584caa73bn,0x3c6ef372fe94f82bn,0xa54ff53a5f1d36f1n,0x510e527fade682d1n,0x9b05688c2b3e6c1fn,0x1f83d9abfb41bd6bn,0x5be0cd19137e2179n];\nconst SHA2_K=[0x428a2f98d728ae22n,0x7137449123ef65cdn,0xb5c0fbcfec4d3b2fn,0xe9b5dba58189dbbcn,0x3956c25bf348b538n,0x59f111f1b605d019n,0x923f82a4af194f9bn,0xab1c5ed5da6d8118n,0xd807aa98a3030242n,0x12835b0145706fben,0x243185be4ee4b28cn,0x550c7dc3d5ffb4e2n,0x72be5d74f27b896fn,0x80deb1fe3b1696b1n,0x9bdc06a725c71235n,0xc19bf174cf692694n,0xe49b69c19ef14ad2n,0xefbe4786384f25e3n,0xfc19dc68b8cd5b5n,0x240ca1cc77ac9c65n,0x2de92c6f592b0275n,0x4a7484aa6ea6e483n,0x5cb0a9dcbd41fbd4n,0x76f988da831153b5n,0x983e5152ee66dfabn,0xa831c66d2db43210n,0xb00327c898fb213fn,0xbf597fc7beef0ee4n,0xc6e00bf33da88fc2n,0xd5a79147930aa725n,0x6ca6351e003826fn,0x142929670a0e6e70n,0x27b70a8546d22ffcn,0x2e1b21385c26c926n,0x4d2c6dfc5ac42aedn,0x53380d139d95b3dfn,0x650a73548baf63den,0x766a0abb3c77b2a8n,0x81c2c92e47edaee6n,0x92722c851482353bn,0xa2bfe8a14cf10364n,0xa81a664bbc423001n,0xc24b8b70d0f89791n,0xc76c51a30654be30n,0xd192e819d6ef5218n,0xd69906245565a910n,0xf40e35855771202an,0x106aa07032bbd1b8n,0x19a4c116b8d2d0c8n,0x1e376c085141ab53n,0x2748774cdf8eeb99n,0x34b0bcb5e19b48a8n,0x391c0cb3c5c95a63n,0x4ed8aa4ae3418acbn,0x5b9cca4f7763e373n,0x682e6ff3d6b2b8a3n,0x748f82ee5defb2fcn,0x78a5636f43172f60n,0x84c87814a1f0ab72n,0x8cc702081a6439ecn,0x90befffa23631e28n,0xa4506cebde82bde9n,0xbef9a3f7b2c67915n,0xc67178f2e372532bn,0xca273eceea26619cn,0xd186b8c721c0c207n,0xeada7dd6cde0eb1en,0xf57d4f7fee6ed178n,0x6f067aa72176fban,0xa637dc5a2c898a6n,0x113f9804bef90daen,0x1b710b35131c471bn,0x28db77f523047d84n,0x32caab7b40c72493n,0x3c9ebe0a15c9bebcn,0x431d67c49c100d4cn,0x4cc5d4becb3e42b6n,0x597f299cfc657e2an,0x5fcb6fab3ad6faecn,0x6c44198c4a475817n];\nconst MASK64=(1n<<64n)-1n;\nconst rotr64=(v,n)=>(v>>BigInt(n))|((v<<BigInt(64-n))&MASK64);\nconst rotr32=(v,n)=>(v>>>n)|(v<<(32-n));\nexport async function digestHex(algorithm,input) {\n  const bytes=input instanceof Uint8Array?input:new Uint8Array(input);\n  if(globalThis.crypto?.subtle) {\n    const hash=await crypto.subtle.digest(algorithm,bytes);\n    return Array.from(new Uint8Array(hash),b=>b.toString(16).padStart(2,'0')).join('');\n  }\n  return sha2(algorithm,bytes);\n}\nexport function sha2(algorithm,bytes) {\n  if(!['SHA-256','SHA-512'].includes(algorithm))throw new Error('Unsupported digest');\n  const wide=algorithm==='SHA-512',block=wide?128:64,words=wide?80:64;\n  const padded=new Uint8Array(Math.ceil((bytes.length+1+(wide?16:8))/block)*block);\n  padded.set(bytes);padded[bytes.length]=128;\n  const view=new DataView(padded.buffer);\n  const bitLength=BigInt(bytes.length)*8n;view.setBigUint64(padded.length-8,bitLength);\n  if(wide) {\n    const h=[...SHA2_H],w=Array(80).fill(0n);\n    for(let offset=0;offset<padded.length;offset+=128) {\n      for(let i=0;i<16;i++)w[i]=view.getBigUint64(offset+i*8);\n      for(let i=16;i<80;i++) {\n        const a=w[i-15],b=w[i-2],s0=rotr64(a,1)^rotr64(a,8)^(a>>7n),s1=rotr64(b,19)^rotr64(b,61)^(b>>6n);\n        w[i]=(w[i-16]+s0+w[i-7]+s1)&MASK64;\n      }\n      let [a,b,c,d,e,f,g,j]=h;\n      for(let i=0;i<80;i++) {\n        const s1=rotr64(e,14)^rotr64(e,18)^rotr64(e,41),ch=(e&f)^((~e)&g);\n        const t1=(j+s1+ch+SHA2_K[i]+w[i])&MASK64;\n        const s0=rotr64(a,28)^rotr64(a,34)^rotr64(a,39),maj=(a&b)^(a&c)^(b&c),t2=(s0+maj)&MASK64;\n        j=g;g=f;f=e;e=(d+t1)&MASK64;d=c;c=b;b=a;a=(t1+t2)&MASK64;\n      }\n      [a,b,c,d,e,f,g,j].forEach((v,i)=>{h[i]=(h[i]+v)&MASK64;});\n    }\n    return h.map(v=>v.toString(16).padStart(16,'0')).join('');\n  }\n  const h=SHA2_H.map(v=>Number(v>>32n)>>>0),k=SHA2_K.slice(0,64).map(v=>Number(v>>32n)>>>0),w=new Uint32Array(words);\n  for(let offset=0;offset<padded.length;offset+=64) {\n    for(let i=0;i<16;i++)w[i]=view.getUint32(offset+i*4);\n    for(let i=16;i<64;i++) {\n      const a=w[i-15],b=w[i-2],s0=rotr32(a,7)^rotr32(a,18)^(a>>>3),s1=rotr32(b,17)^rotr32(b,19)^(b>>>10);\n      w[i]=(w[i-16]+s0+w[i-7]+s1)>>>0;\n    }\n    let [a,b,c,d,e,f,g,j]=h;\n    for(let i=0;i<64;i++) {\n      const s1=rotr32(e,6)^rotr32(e,11)^rotr32(e,25),ch=(e&f)^(~e&g),t1=(j+s1+ch+k[i]+w[i])>>>0;\n      const s0=rotr32(a,2)^rotr32(a,13)^rotr32(a,22),maj=(a&b)^(a&c)^(b&c),t2=(s0+maj)>>>0;\n      j=g;g=f;f=e;e=(d+t1)>>>0;d=c;c=b;b=a;a=(t1+t2)>>>0;\n    }\n    [a,b,c,d,e,f,g,j].forEach((v,i)=>{h[i]=(h[i]+v)>>>0;});\n  }\n  return h.map(v=>v.toString(16).padStart(8,'0')).join('');\n}\n", "type": "text/javascript; charset=utf-8"}, "/netplay/direct-room.mjs": {"text": "// MIT License \u2014 Copyright (c) 2026 Rick Gerkin.\nimport {PartyRoom} from './party-room.mjs';\n// Star topology: every guest has one authenticated direct link to player 1.\n// Player 1 forwards peer messages over those links, never through the server.\nclass DirectChannel {\n  constructor(room){this.room=room;this.readyState='connecting';}\n  get bufferedAmount(){return Math.max(0,...[...this.room.links.values()].map(l=>l.channel?.bufferedAmount||0));}\n  send(data){\n    if(typeof data!=='string'||data.length>4096||this.bufferedAmount>262144)throw new Error('Direct channel is congested');\n    if(this.room.player===1)for(const link of this.room.links.values())link.channel.send(JSON.stringify({from:1,data}));\n    else this.room.links.get(1).channel.send(data);\n  }\n  close(){this.readyState='closed';}\n}\nexport class DirectRoom extends PartyRoom {\n  constructor(options){super(options);this.players=options.players;this.links=new Map();this.relay=false;this.receiving=null;}\n  async open(){\n    if(!globalThis.RTCPeerConnection)throw new Error('This browser does not support WebRTC');\n    this.channel=new DirectChannel(this);this.opened=performance.now();\n    this.poll().catch(error=>this.fail(error));\n  }\n  async poll(){\n    while(!this.closed && !this.started){\n      const status=await this.request(`/api/rooms/${this.id}`);\n      if(this.player===1){\n        for(const player of status.roster.filter(p=>p!==1)){\n          let link=this.links.get(player);\n          if(!link){link=this.link(player);this.bind(link,link.pc.createDataChannel('contra-direct',{ordered:true}));\n            await link.pc.setLocalDescription(await link.pc.createOffer());await this.gather(link.pc);\n            await this.request(`/api/rooms/${this.id}`,{to:player,description:link.pc.localDescription.toJSON()});}\n          if(status.answers[player]&&!link.pc.remoteDescription)await link.pc.setRemoteDescription(status.answers[player]);\n        }\n      } else if(status.offers[this.player]&&!this.links.has(1)){\n        const link=this.link(1);link.pc.ondatachannel=event=>{if(event.channel.label!=='contra-direct'||link.channel){event.channel.close();return;}this.bind(link,event.channel);};\n        await link.pc.setRemoteDescription(status.offers[this.player]);await link.pc.setLocalDescription(await link.pc.createAnswer());await this.gather(link.pc);\n        await this.request(`/api/rooms/${this.id}`,{to:1,description:link.pc.localDescription.toJSON()});\n      }\n      if(!this.started&&performance.now()-this.opened>180000)throw new Error('Direct connection timed out. Check LAN firewall or Wi-Fi client isolation.');\n      await new Promise(resolve=>setTimeout(resolve,500));\n    }\n  }\n  link(player){\n    const pc=new RTCPeerConnection({iceServers:[],iceTransportPolicy:'all'}),link={player,pc,channel:null};this.links.set(player,link);\n    pc.onconnectionstatechange=()=>{this.onDiagnostic?.(`Player ${player}: ${pc.connectionState}`);if(['failed','closed'].includes(pc.connectionState))this.fail(new Error('Direct connection failed. Cloud relay is disabled.'));};\n    return link;\n  }\n  async gather(pc){\n    if(pc.iceGatheringState==='complete')return;\n    await new Promise((resolve,reject)=>{const timer=setTimeout(()=>{pc.removeEventListener('icegatheringstatechange',check);reject(new Error('Local ICE gathering timed out'));},10000);\n      const check=()=>{if(pc.iceGatheringState==='complete'){clearTimeout(timer);pc.removeEventListener('icegatheringstatechange',check);resolve();}};pc.addEventListener('icegatheringstatechange',check);check();});\n  }\n  bind(link,channel){\n    link.channel=channel;channel.binaryType='arraybuffer';\n    channel.onopen=()=>{\n      if(this.closed)return;\n      if(this.player===1){const rom=this.getCartridge?.();if(rom){channel.send(JSON.stringify({cartridge:131088}));for(let offset=0;offset<rom.length;offset+=16384)channel.send(Uint8Array.from(rom.slice(offset,offset+16384),c=>c.charCodeAt(0)));}}\n      this.openIfReady();\n      if(this.player===1)this.hello();\n    };\n    channel.onclose=()=>{if(!this.closed)this.fail(new Error('A player disconnected. Create a new room.'));};\n    channel.onerror=()=>this.fail(new Error('Direct data channel error'));\n    channel.onmessage=event=>{try{this.receiveDirect(link,event.data);}catch(error){this.fail(error);}};\n  }\n  openIfReady(){\n    const count=this.player===1?this.players-1:1;\n    if(this.channel.readyState==='open'||this.links.size!==count||[...this.links.values()].some(l=>l.channel?.readyState!=='open'))return;\n    this.channel.readyState='open';this.lastSeen=new Map();this.hello();\n    this.timer=setInterval(()=>{\n      if(this.started&&[...this.lastSeen.values()].some(t=>performance.now()-t>15000))return this.fail(new Error('A player stopped responding'));\n      this.hello();if(this.ready)this.send({kind:'ready'});this.lastPing=performance.now();this.send({kind:'ping',time:this.lastPing});\n    },1000);\n    this.onStatus(`Direct links established. Waiting for ${this.players} players to verify the cartridge.`);\n  }\n  hello(){if(this.channel.readyState==='open')this.send({kind:'hello',protocol:'contra-four-player-1',rom:this.fingerprint,players:this.players});}\n  receiveDirect(link,data){\n    if(data instanceof ArrayBuffer){\n      if(this.player===1||!this.receiving||data.byteLength>16384||this.receiving.offset+data.byteLength>131088)throw new Error('Unexpected cartridge chunk');\n      this.receiving.bytes.set(new Uint8Array(data),this.receiving.offset);this.receiving.offset+=data.byteLength;\n      if(this.receiving.offset===131088){const bytes=this.receiving.bytes;this.receiving=null;Promise.resolve(this.onCartridge?.(bytes.buffer)).catch(error=>this.fail(error));}\n      return;\n    }\n    if(typeof data!=='string'||data.length>8192)throw new Error('Invalid direct message');\n    const value=JSON.parse(data);\n    if(this.player!==1&&value.cartridge===131088){if(this.receiving||this.started)throw new Error('Unexpected cartridge transfer');this.receiving={bytes:new Uint8Array(131088),offset:0};return;}\n    let from,packet;\n    if(this.player===1){from=link.player;packet=value;\n      for(const other of this.links.values())if(other.player!==from&&other.channel?.readyState==='open')other.channel.send(JSON.stringify({from,data}));\n    } else {\n      if(!Number.isInteger(value.from)||value.from<1||value.from>this.players||value.from===this.player||typeof value.data!=='string'||value.data.length>4096)throw new Error('Invalid forwarded sender');\n      from=value.from;packet=JSON.parse(value.data);\n    }\n    if(packet.kind==='hello')this.openIfReady();\n    this.receive(packet,from);\n  }\n  close(){if(this.closed)return;super.close();for(const {pc,channel}of this.links.values()){pc.onconnectionstatechange=null;if(channel){channel.onclose=null;channel.onerror=null;channel.onmessage=null;}pc.close();}}\n}\n", "type": "text/javascript; charset=utf-8"}, "/netplay/frame-sync.mjs": {"text": "// MIT License \u2014 Copyright (c) 2026 Rick Gerkin.\n// Transport-independent lockstep for the original engine and squad extension.\nconst VERSION = 1;\n\nfunction integer(value, min, max, label) {\n  if (!Number.isSafeInteger(value) || value < min || value > max) {\n    throw new RangeError(`Invalid ${label}`);\n  }\n  return value;\n}\n\nexport class FrameSync {\n  constructor({session, players = 2, localPlayer, delay = 3, maxFutureFrames = 120}) {\n    if (typeof session !== 'string' || !session.length || session.length > 128) {\n      throw new TypeError('A session identifier is required');\n    }\n    this.players = integer(players, 2, 4, 'player count');\n    this.localPlayer = integer(localPlayer, 1, players, 'local player');\n    this.delay = integer(delay, 0, 12, 'input delay');\n    this.maxFutureFrames = integer(maxFutureFrames, Math.max(delay, 1), 600, 'input horizon');\n    this.session = session;\n    this.frame = 0;\n    this.paused = false;\n    this.pending = new Map();\n    // Both sides begin from the same emulator reset. The delay's initial frames\n    // are neutral, so startup doesn't require sending fabricated remote input.\n    for (let frame = 0; frame < delay; frame++) {\n      this.pending.set(frame, new Map(Array.from({length: players}, (_, i) => [i + 1, 0])));\n    }\n  }\n\n  // Schedule once per simulation frame, before trying to consume it. Repeating\n  // this while waiting retransmits exactly the original input for that frame.\n  schedule(mask) {\n    integer(mask, 0, 255, 'controller mask');\n    const frame = this.frame + this.delay;\n    const saved = this.pending.get(frame)?.get(this.localPlayer);\n    const packet = {version: VERSION, kind: 'input', session: this.session,\n      frame, player: this.localPlayer, mask: saved ?? mask};\n    this.receive(packet, this.localPlayer);\n    return packet;\n  }\n\n  // The transport must bind senderPlayer to the authenticated peer connection;\n  // it must never take senderPlayer from the incoming packet itself.\n  receive(packet, senderPlayer) {\n    integer(senderPlayer, 1, this.players, 'sender');\n    if (!packet || packet.version !== VERSION || packet.kind !== 'input' || packet.session !== this.session) {\n      throw new TypeError('Invalid input packet or session');\n    }\n    integer(packet.player, 1, this.players, 'packet player');\n    integer(packet.frame, 0, Number.MAX_SAFE_INTEGER, 'frame');\n    integer(packet.mask, 0, 255, 'controller mask');\n    if (packet.player !== senderPlayer) throw new Error('Peer cannot control another player');\n    if (packet.frame < this.frame) return false; // Old retransmission; never rewind.\n    if (packet.frame - this.frame > this.maxFutureFrames) throw new RangeError('Input too far ahead');\n    const inputs = this.pending.get(packet.frame) ?? new Map();\n    const previous = inputs.get(packet.player);\n    if (previous !== undefined && previous !== packet.mask) throw new Error('Conflicting input for a committed frame');\n    inputs.set(packet.player, packet.mask);\n    this.pending.set(packet.frame, inputs);\n    return previous === undefined;\n  }\n\n  get missingPlayers() {\n    const inputs = this.pending.get(this.frame);\n    return Array.from({length: this.players}, (_, i) => i + 1).filter(player => !inputs?.has(player));\n  }\n\n  // The caller runs exactly one nes.frame() per returned record. A missing\n  // record means wait for the peer: never guess inputs or advance on wall time.\n  takeFrame() {\n    if (this.paused || this.missingPlayers.length) return null;\n    const inputs = this.pending.get(this.frame);\n    const record = Object.freeze({frame: this.frame,\n      inputs: Object.freeze(Array.from({length: this.players}, (_, i) => inputs.get(i + 1)))});\n    this.pending.delete(this.frame);\n    this.frame++;\n    return record;\n  }\n}\n\nexport function applyInputs(nes, inputs) {\n  if(nes.fourPlayer)nes.fourPlayer.setInputs(inputs);\n  const ports=nes.fourPlayer?2:inputs.length;\n  for (let player = 1; player <= ports; player++) {\n    if (!nes.controllers[player]) throw new Error(`Game engine has no controller port for player ${player}`);\n    integer(inputs[player - 1], 0, 255, 'controller mask');\n  }\n  for (let player = 1; player <= ports; player++) {\n    for (let button = 0; button < 8; button++) {\n      nes[inputs[player - 1] & (1 << button) ? 'buttonDown' : 'buttonUp'](player, button);\n    }\n  }\n}\n", "type": "text/javascript; charset=utf-8"}, "/netplay/game-session.mjs": {"text": "// MIT License \u2014 Copyright (c) 2026 Rick Gerkin.\nimport {FourPlayer} from '../gameplay/four-player.mjs';\nimport {FrameSync, applyInputs} from './frame-sync.mjs';\nimport {prepareTwoPlayerGame, stateHash} from './game.mjs';\n\n// Owns simulation time; rendering, audio output, and transport live outside it.\nexport class GameSession {\n  constructor({nes,rom,room,player,players=2,send,onState=()=>{},onVerified=()=>{},onFatal=()=>{}}) {\n    Object.assign(this,{nes,rom,room,player,players,send,onState,onVerified,onFatal});\n    this.epoch=0;this.generation=0;this.closed=false;this.deferred=[];\n  }\n  start() {this.initialize();}\n  get frame(){return this.sync.frame;}\n  initialize() {\n    const deferred=this.deferred;this.deferred=[];\n    this.generation++;this.paused=false;this.commands=[];this.lastScheduled=-1;\n    this.localHashes=new Map();this.remoteHashes=new Map();\n    prepareTwoPlayerGame(this.nes,this.rom);\n    if(this.players>2)new FourPlayer(this.nes,this.players);\n    this.sync=new FrameSync({session:`${this.room}:${this.epoch}`,localPlayer:this.player,players:this.players,delay:4});\n    for(const entry of deferred){if(entry.type==='input')this.input(entry.packet,entry.player);else this.hash(entry.packet,entry.player);}\n    this.onState('running');this.capture();\n  }\n  close(){this.closed=true;this.generation++;}\n  fail(message){if(!this.closed){this.close();this.onFatal(new Error(message));}}\n  defer(entry) {\n    if(this.deferred.length>=128)throw new Error('Too many future-epoch messages');\n    this.deferred.push(entry);\n  }\n  input(packet,player) {\n    if(this.closed)return;\n    if(packet.session===`${this.room}:${this.epoch}`)this.sync.receive(packet,player);\n    else if(packet.session===`${this.room}:${this.epoch+1}` && this.commands.some(c=>c.action==='reset'))this.defer({type:'input',packet,player});\n  }\n  hash(packet,player=3-this.player) {\n    if(this.closed)return;\n    if(packet.epoch!==this.epoch) {\n      if(packet.epoch===this.epoch+1 && this.commands.some(c=>c.action==='reset'))this.defer({type:'hash',packet,player});\n      return;\n    }\n    if(this.remoteHashes.size>=16)throw new Error('Too many unverified state checksums');\n    if(!Number.isInteger(player)||player<1||player>this.players||player===this.player)throw new Error('Invalid checksum sender');\n    const hashes=this.remoteHashes.get(packet.frame) ?? new Map();\n    hashes.set(player,packet.hash);this.remoteHashes.set(packet.frame,hashes);this.compare(packet.frame);\n  }\n  compare(frame) {\n    const ours=this.localHashes.get(frame),theirs=this.remoteHashes.get(frame);\n    if(ours && theirs) {\n      if([...theirs.values()].some(hash=>hash!==ours)){this.fail('Game states diverged. Create a new room to restart in sync.');return;}\n      if(theirs.size!==this.players-1)return;\n      this.onVerified({frame,hash:ours,epoch:this.epoch});\n      this.localHashes.delete(frame);this.remoteHashes.delete(frame);\n    }\n  }\n  async capture() {\n    const {generation,epoch}=this,frame=this.frame;\n    try {\n      const hash=await stateHash(this.nes);\n      if(this.closed || this.generation!==generation)return;\n      this.localHashes.set(frame,hash);this.send({kind:'hash',frame,epoch,hash});this.compare(frame);\n      if(this.localHashes.size>16 || this.remoteHashes.size>16)this.fail('Peer checksum verification timed out.');\n    }catch(error){if(this.generation===generation)this.fail(error.message);}\n  }\n  request(action) {\n    if(!['pause','resume','reset'].includes(action))throw new Error('Unknown room action');\n    if(this.closed)return;\n    if(this.player!==1){this.send({kind:'request',action});return;}\n    if(this.commands.length>=32)throw new Error('Too many pending room controls');\n    let frame=this.paused?this.frame:this.frame+this.sync.delay+2;\n    if(action==='resume')frame=this.commands.find(c=>c.action==='pause')?.frame ?? this.frame;\n    const packet={kind:'command',action,frame,epoch:this.epoch};\n    this.send(packet);this.command(packet,false);\n  }\n  command(packet,isRequest) {\n    if(this.closed)return;\n    if(isRequest){if(this.player!==1)throw new Error('Only host accepts control requests');this.request(packet.action);return;}\n    if(packet.epoch!==this.epoch || !['pause','resume','reset'].includes(packet.action) || !Number.isSafeInteger(packet.frame) || packet.frame<this.frame || packet.frame>this.frame+120)throw new Error('Invalid control frame');\n    if(this.commands.length>=32)throw new Error('Too many pending room controls');\n    this.commands.push(packet);this.commands.sort((a,b)=>a.frame-b.frame);\n  }\n  step(mask) {\n    if(this.closed)return {state:'closed',advanced:false,scheduled:false};\n    while(this.commands.length && this.commands[0].frame===this.frame) {\n      const command=this.commands.shift();\n      if(command.action==='reset') {\n        this.epoch++;this.initialize();\n        return {state:'reset',advanced:false,scheduled:false};\n      }\n      this.paused=command.action==='pause';this.onState(this.paused?'paused':'running');\n    }\n    if(this.commands.length && this.commands[0].frame<this.frame)throw new Error('Room control arrived too late. Reconnect to resynchronize.');\n    if(this.paused)return {state:'paused',advanced:false,scheduled:false};\n    let scheduled=false;\n    if(this.lastScheduled!==this.frame+this.sync.delay) {\n      const packet=this.sync.schedule(mask);this.send(packet);this.lastScheduled=packet.frame;scheduled=true;\n    }\n    const record=this.sync.takeFrame();\n    if(!record)return {state:'waiting',advanced:false,scheduled};\n    applyInputs(this.nes,record.inputs);this.nes.frame();\n    if(this.frame%120===0)this.capture();\n    return {state:'running',advanced:true,scheduled};\n  }\n}\n", "type": "text/javascript; charset=utf-8"}, "/netplay/game.mjs": {"text": "import {digestHex} from './digest.mjs';\n// MIT License \u2014 Copyright (c) 2026 Rick Gerkin.\n// Deterministic two-player boot using only controller input and RAM state\n// observations. No copyrighted game instructions or assets are embedded here.\nexport function prepareTwoPlayerGame(nes, rom) {\n  nes.fourPlayer?.dispose();\n  nes.loadROM(rom);\n  for(let p=1;p<=2;p++)for(let b=0;b<8;b++)nes.buttonUp(p,b);\n  const step=count=>{for(let i=0;i<count;i++)nes.frame();};\n  step(600);\n  nes.buttonDown(1,2);step(2);nes.buttonUp(1,2);step(2);\n  nes.buttonDown(1,3);step(2);nes.buttonUp(1,3);\n  for(let i=0;i<900;i++) {\n    if(nes.cpu.mem[0x18]===5 && nes.cpu.mem[0x2c]===4 && nes.cpu.mem[0x90]===1 && nes.cpu.mem[0x91]===1) {\n      if(nes.cpu.mem[0x22]!==1 || nes.cpu.mem[0x1c]!==0)throw new Error('Two-player startup verification failed');\n      return;\n    }\n    nes.frame();\n  }\n  throw new Error('Could not enter two-player gameplay');\n}\n\nexport async function stateHash(nes) {\n  const bytes=new TextEncoder().encode(JSON.stringify(nes.toJSON()));\n  return digestHex('SHA-256',bytes);\n}\n", "type": "text/javascript; charset=utf-8"}, "/netplay/party-room.mjs": {"text": "// MIT License \u2014 Copyright (c) 2026 Rick Gerkin.\nimport {RelayChannel} from './relay.mjs';\nconst PARTY_PROTOCOL='contra-four-player-1';\nexport class PartyRoom {\n  constructor(options) {\n    Object.assign(this,options);this.players=options.players || 4;\n    this.abort=new AbortController();this.peers=new Set();this.readyPeers=new Set();\n    this.lastSeen=new Map();this.closed=false;this.ready=false;this.started=false;this.relay=true;\n  }\n  get player(){return this.credentials?.player;}\n  get id(){return this.credentials?.room;}\n  get connected(){return !this.closed && this.channel?.readyState==='open' && this.peers.size===this.players-1;}\n  async request(path,body) {\n    const response=await fetch(path,{method:body?'POST':'GET',signal:this.abort.signal,\n      headers:{...(body?{'Content-Type':'application/json'}:{}),...(this.credentials?{Authorization:`Bearer ${this.credentials.token}`}:{})},\n      ...(body?{body:JSON.stringify(body)}:{})});\n    const result=await response.json();if(!response.ok)throw new Error(result.error||'Room service unavailable');return result;\n  }\n  async host() {\n    this.credentials=await this.request('/api/rooms',{players:this.players});\n    if(this.credentials.players!==this.players)throw new Error('Restart the server to enable the new squad room API.');\n    const link=new URL(location.href);link.hash=new URLSearchParams({room:this.id,invite:this.credentials.invite,players:this.players}).toString();\n    this.onStatus(`Room created for ${this.players} players. Share the invitation with everyone.`,link.href);\n    await this.open();\n  }\n  async join(room,invite) {\n    this.credentials=await this.request(`/api/rooms/${encodeURIComponent(room)}`,{invite});\n    if(this.credentials.players!==this.players)throw new Error('Invitation player count does not match room');\n    await this.open();\n  }\n  async open() {\n    this.channel=new RelayChannel({room:this.id,player:this.player,players:this.players,token:this.credentials.token,\n      request:(...args)=>this.request(...args),signal:this.abort.signal,onError:error=>this.fail(error)});\n    this.channel.onmessage=event=>{try{this.receive(JSON.parse(event.data),event.from);}catch(error){this.fail(error);}};\n    await this.channel.open();\n    this.opened=performance.now();\n    const heartbeat=()=>{\n      if(this.closed)return;\n      const now=performance.now();\n      if(!this.connected && now-this.opened>180000)return this.fail(new Error('Room did not fill within three minutes.'));\n      if(this.started && [...this.lastSeen.values()].some(t=>now-t>15000))return this.fail(new Error('A player stopped responding. Create a new room.'));\n      this.send({kind:'hello',protocol:PARTY_PROTOCOL,rom:this.fingerprint,players:this.players});\n      if(this.ready)this.send({kind:'ready'});\n      this.lastPing=now;this.send({kind:'ping',time:now});\n    };\n    heartbeat();this.timer=setInterval(heartbeat,1000);\n    this.onDiagnostic?.(`Server relay open; waiting for ${this.players-1} peers`);\n  }\n  receive(packet,from) {\n    if(!Number.isInteger(from)||from<1||from>this.players||from===this.player||!packet||typeof packet!=='object')throw new Error('Invalid party sender/message');\n    this.lastSeen.set(from,performance.now());\n    if(packet.kind==='hello') {\n      if(packet.protocol!==PARTY_PROTOCOL||packet.rom!==this.fingerprint||packet.players!==this.players)throw new Error('Cartridge or multiplayer version mismatch');\n      const added=!this.peers.has(from);this.peers.add(from);\n      if(added){this.send({kind:'hello',protocol:PARTY_PROTOCOL,rom:this.fingerprint,players:this.players});this.onStatus(`${this.peers.size+1}/${this.players} players connected. You are player ${this.player}.${this.connected?' Click Ready.':''}`);}\n      return;\n    }\n    if(!this.peers.has(from))return; // Hello heartbeat establishes each authenticated stream.\n    switch(packet.kind) {\n      case 'ready':this.readyPeers.add(from);this.maybeStart();break;\n      case 'start':\n        if(from!==1||this.player===1||!this.connected||!this.ready)throw new Error('Invalid party start');\n        if(!this.started){this.started=true;this.onStart();}break;\n      case 'input':if(!this.started)throw new Error('Input before start');this.onInput(packet,from);break;\n      case 'hash':\n        if(!Number.isSafeInteger(packet.frame)||packet.frame<0||!Number.isSafeInteger(packet.epoch)||packet.epoch<0||!/^[a-f0-9]{64}$/.test(packet.hash))throw new Error('Invalid party checksum');\n        this.onHash(packet,from);break;\n      case 'request':if(this.player===1)this.onCommand(packet,true);break;\n      case 'command':if(from!==1||this.player===1)throw new Error('Only host can schedule commands');this.onCommand(packet,false);break;\n      case 'ping':if(!Number.isFinite(packet.time))throw new Error('Invalid ping');this.send({kind:'pong',to:from,time:packet.time});break;\n      case 'pong':if(packet.to===this.player && packet.time===this.lastPing)this.onLatency(Math.round(performance.now()-packet.time));break;\n      default:throw new Error('Unknown party message');\n    }\n  }\n  send(packet) {\n    if(this.closed || this.channel?.readyState!=='open')return false;\n    try{this.channel.send(JSON.stringify(packet));return true;}catch(error){this.fail(error);return false;}\n  }\n  markReady(){if(!this.connected||this.ready)return;this.ready=true;this.send({kind:'ready'});this.maybeStart();}\n  maybeStart(){if(this.player===1 && this.ready && this.readyPeers.size===this.players-1 && !this.started){this.send({kind:'start'});this.started=true;this.onStart();}}\n  fail(error){if(!this.closed){this.close();this.onClose(error.message);}}\n  close(){if(this.closed)return;this.closed=true;clearInterval(this.timer);this.channel?.close();this.abort.abort();}\n}\n", "type": "text/javascript; charset=utf-8"}, "/netplay/relay.mjs": {"text": "// MIT License \u2014 Copyright (c) 2026 Rick Gerkin.\n// Same-origin, authenticated streaming HTTP fallback; uses TLS when hosted on\n// HTTPS. It carries only the bounded room protocol, not the ROM or snapshots.\nexport class RelayChannel {\n  constructor({room,player,players=2,request,token,signal,onError}) {\n    Object.assign(this,{room,player,players,request,token,signal,onError});\n    this.readyState='connecting';this.pending=[];this.sending=false;this.bytes=0;\n  }\n  get bufferedAmount(){return this.bytes;}\n  async open() {\n    const response=await fetch(`/api/rooms/${this.room}/events`,{headers:{Authorization:`Bearer ${this.token}`},signal:this.signal});\n    if(!response.ok){const result=await response.json();throw new Error(result.error || 'Relay stream unavailable');}\n    this.reader=response.body.getReader();this.readyState='open';this.onopen?.();\n    this.receive().catch(error=>{if(this.readyState!=='closed')this.onError(error);});\n  }\n  send(data) {\n    if(this.readyState!=='open')throw new Error('Relay is not open');\n    if(typeof data!=='string' || data.length>4096 || this.bytes+data.length>262144)throw new Error('Relay send buffer is full');\n    this.pending.push(data);this.bytes+=data.length;\n    this.flush().catch(error=>{if(this.readyState!=='closed')this.onError(error);});\n  }\n  async flush() {\n    if(this.sending)return;\n    this.sending=true;\n    try {\n      while(this.pending.length && this.readyState==='open') {\n        const messages=this.pending.splice(0,16);\n        await this.request(`/api/rooms/${this.room}`,{messages});\n        this.bytes=Math.max(0,this.bytes-messages.reduce((sum,message)=>sum+message.length,0));\n      }\n    } finally {this.sending=false;}\n  }\n  async receive() {\n    const decoder=new TextDecoder();let buffer='';\n    while(this.readyState==='open') {\n      const {value,done}=await this.reader.read();\n      if(done)throw new Error('Relay disconnected. Create a new room to reconnect.');\n      buffer+=decoder.decode(value,{stream:true});\n      let end;\n      while((end=buffer.indexOf('\\n'))!==-1) {\n        const line=buffer.slice(0,end);buffer=buffer.slice(end+1);\n        if(line.length>262144)throw new Error('Relay batch is too large');\n        if(!line)continue;\n        const messages=JSON.parse(line);\n        if(!Array.isArray(messages) || messages.length>32)throw new Error('Invalid relay batch');\n        for(const message of messages) {\n          if(!Number.isInteger(message.from) || message.from<1 || message.from>this.players || message.from===this.player || typeof message.data!=='string' || message.data.length>4096)throw new Error('Invalid relay sender/message');\n          this.onmessage?.({data:message.data,from:message.from});\n        }\n      }\n      if(buffer.length>262144)throw new Error('Relay frame is too large');\n    }\n  }\n  close() {\n    if(this.readyState==='closed')return;\n    this.readyState='closed';this.pending=[];this.bytes=0;\n    this.reader?.cancel().catch(()=>{});\n  }\n}\n", "type": "text/javascript; charset=utf-8"}, "/netplay/room.mjs": {"text": "import {RelayChannel} from './relay.mjs';\n// MIT License \u2014 Copyright (c) 2026 Rick Gerkin.\nconst PROTOCOL = 'contra-jsnes-2.1.0-netplay-1';\nconst sleep = ms => new Promise(resolve => setTimeout(resolve, ms));\n\nexport class Room {\n  constructor({fingerprint, onStatus, onStart, onInput, onCommand, onHash, onClose, onLatency, onDiagnostic=()=>{}, preferRelay=false}) {\n    Object.assign(this,{fingerprint,onStatus,onStart,onInput,onCommand,onHash,onClose,onLatency,onDiagnostic,preferRelay});\n    this.closed=false; this.ready=false; this.remoteReady=false; this.started=false;\n    this.credentials=null;this.pc=null;this.channel=null;this.pingTimer=null;this.timeout=null;\n    this.abort=new AbortController();\n  }\n  async request(path, body) {\n    const response=await fetch(path,{method:body?'POST':'GET',\n      headers:{...(body?{'Content-Type':'application/json'}:{}),...(this.credentials?{Authorization:`Bearer ${this.credentials.token}`}:{})},\n      ...(body?{body:JSON.stringify(body)}:{}),signal:this.abort.signal});\n    const result=await response.json();\n    if(!response.ok)throw new Error(result.error || 'Room service unavailable');\n    return result;\n  }\n  trace(message){this.onDiagnostic(message);}\n  get player() { return this.credentials?.player; }\n  get id() { return this.credentials?.room; }\n  get connected() { return !this.closed && this.channel?.readyState==='open' && this.verified; }\n  async host() {\n    this.credentials=await this.request('/api/rooms',{});\n    const link=new URL(location.href);link.hash=new URLSearchParams({room:this.id,invite:this.credentials.invite}).toString();\n    this.onStatus('Room created. Send the invitation link to your partner.',link.href);\n    await this.setup(true);\n    if(!this.relay){\n      await this.pc.setLocalDescription(await this.pc.createOffer());\n      await this.gather();\n      if(!this.relay){this.trace('Host offer ready');await this.request(`/api/rooms/${this.id}`,{description:this.pc.localDescription.toJSON()});}\n    }\n    this.poll(true).catch(error=>this.fail(error));\n  }\n  async join(room,invite) {\n    this.credentials=await this.request(`/api/rooms/${encodeURIComponent(room)}`,{invite});\n    this.onStatus('Joined as player 2. Connecting to host\u2026');\n    await this.setup(false);\n    this.poll(false).catch(error=>this.fail(error));\n  }\n  async setup(host) {\n    const {iceServers}=await this.request('/api/config');\n    if(this.closed)return;\n    if(this.preferRelay || !globalThis.RTCPeerConnection){await this.startRelay();return;}\n    this.pc=new RTCPeerConnection({iceServers});\n    this.pc.onsignalingstatechange=()=>this.trace(`Signaling: ${this.pc.signalingState}`);\n    this.pc.onicegatheringstatechange=()=>this.trace(`ICE gathering: ${this.pc.iceGatheringState}`);\n    this.pc.oniceconnectionstatechange=()=>this.trace(`ICE connection: ${this.pc.iceConnectionState}`);\n    this.pc.onicecandidate=event=>{if(event.candidate)this.trace(`Local candidate: ${event.candidate.type || 'unknown'}`);};\n    this.pc.onicecandidateerror=event=>this.trace(`ICE server error: ${event.errorCode}`);\n    this.pc.onconnectionstatechange=()=>{\n      this.trace(`Peer connection: ${this.pc.connectionState}`);\n      if(this.pc.connectionState==='failed')this.fallback();\n      else if(this.pc.connectionState==='closed')this.fail(new Error('Peer connection closed. Create a new room to reconnect.'));\n      if(this.pc.connectionState==='disconnected')this.onStatus('Connection interrupted; waiting for your partner\u2026');\n    };\n    this.timeout=setTimeout(()=>this.fail(new Error('Connection timed out. Check the shared HTTPS address and STUN/TURN configuration.')),180000);\n    if(host)this.bind(this.pc.createDataChannel('contra-input',{ordered:true}));\n    else this.pc.ondatachannel=event=>{\n      if(this.channel || event.channel.label!=='contra-input'){event.channel.close();return;}\n      this.bind(event.channel);\n    };\n  }\n  async gather() {\n    if(this.relay || this.pc.iceGatheringState==='complete')return;\n    await new Promise(resolve=>{\n      const done=()=>{clearTimeout(timer);this.pc.removeEventListener('icegatheringstatechange',check);resolve();};\n      const check=()=>{if(this.pc.iceGatheringState==='complete')done();};\n      const timer=setTimeout(done,10000);\n      this.pc.addEventListener('icegatheringstatechange',check);check();\n    });\n    if(this.closed)throw new Error('Room closed');\n  }\n  async poll(host) {\n    while(!this.closed) {\n      const status=await this.request(`/api/rooms/${this.id}`);\n      if(status.relay && !this.relay)await this.startRelay();\n      if(!this.relay && !this.pc.remoteDescription) {\n        const description=host?status.answer:status.offer;\n        if(description) {\n          this.trace(`Received ${description.type}`);\n          await this.pc.setRemoteDescription(description);\n          if(!host) {\n            await this.pc.setLocalDescription(await this.pc.createAnswer());await this.gather();\n            if(!this.relay)await this.request(`/api/rooms/${this.id}`,{description:this.pc.localDescription.toJSON()});\n          }\n        }\n      }\n      await sleep(750);\n    }\n  }\n  fallback() {\n    if(this.closed || this.relay)return;\n    if(this.started){this.fail(new Error('Direct connection interrupted. Create a new room using Server relay.'));return;}\n    this.startRelay().catch(error=>this.fail(error));\n  }\n  async startRelay() {\n    if(this.closed || this.relay)return;\n    if(this.started)throw new Error('Partner requested a different transport during gameplay; create a new room.');\n    this.relay=true;this.verified=false;this.ready=false;this.remoteReady=false;\n    clearInterval(this.pingTimer);clearTimeout(this.timeout);\n    if(this.channel){this.channel.onclose=null;this.channel.onerror=null;this.channel.onmessage=null;this.channel.onopen=null;this.channel.close();this.channel=null;}\n    if(this.pc){this.pc.onconnectionstatechange=null;this.pc.oniceconnectionstatechange=null;this.pc.close();}\n    this.trace('Using same-server HTTP relay');this.onStatus('Connecting through the server relay\u2026');\n    await this.request(`/api/rooms/${this.id}`,{transport:'relay'});\n    if(this.closed)return;\n    const channel=new RelayChannel({room:this.id,player:this.player,token:this.credentials.token,\n      request:(...args)=>this.request(...args),signal:this.abort.signal,onError:error=>this.fail(error)});\n    this.bind(channel);await channel.open();\n  }\n  bind(channel) {\n    this.channel=channel;\n    channel.onopen=()=>{\n      this.trace(this.relay?'Server relay open':'Data channel open');\n      this.lastSeen=performance.now();\n      clearTimeout(this.timeout);this.timeout=setTimeout(()=>this.fail(new Error('Partner did not connect in time. Create a new room.')),180000);\n      this.send({kind:'hello',protocol:PROTOCOL,rom:this.fingerprint,player:this.player,delay:4});\n      this.pingTimer=setInterval(()=>{\n        if(this.verified && performance.now()-this.lastSeen>15000)return this.fail(new Error('Partner stopped responding. Create a new room to reconnect.'));\n        this.lastPing=performance.now();this.send({kind:'ping',time:this.lastPing});\n      },1000);\n    };\n    channel.onclose=()=>{if(!this.started&&!this.relay)this.fallback();else this.fail(new Error('Partner left the room.'));};\n    channel.onerror=()=>{if(!this.started&&!this.relay)this.fallback();else this.fail(new Error('Data channel error.'));};\n    channel.onmessage=event=>{\n      try {\n        if(typeof event.data!=='string' || event.data.length>4096)throw new Error('Invalid peer message');\n        const packet=JSON.parse(event.data);this.lastSeen=performance.now();\n        if(!packet || typeof packet!=='object')throw new Error('Invalid peer message');\n        if(packet.kind==='hello') {\n          if(this.verified || packet.protocol!==PROTOCOL || packet.rom!==this.fingerprint || packet.player!==3-this.player || packet.delay!==4)\n            throw new Error('Game version or room protocol does not match your partner.');\n          this.trace('Game handshake verified');\n          this.verified=true;clearTimeout(this.timeout);this.onStatus(`Connected as player ${this.player} via ${this.relay?'server relay':'WebRTC'}. Click Ready when both players have loaded their ROM.`);\n          return;\n        }\n        if(!this.verified)throw new Error('Peer handshake required');\n        switch(packet.kind) {\n          case 'ready':\n            this.remoteReady=true;this.onStatus('Partner is ready.');this.maybeStart();break;\n          case 'start':\n            if(this.player!==2 || this.started || !this.ready || !this.remoteReady)throw new Error('Unexpected start');\n            this.started=true;this.onStart();break;\n          case 'input':\n            if(!this.started)throw new Error('Input before start');\n            this.onInput(packet,3-this.player);break;\n          case 'request':\n            if(this.player!==1 || !['pause','resume','reset'].includes(packet.action))throw new Error('Invalid room request');\n            this.onCommand(packet,true);break;\n          case 'command':\n            if(this.player!==2 || !['pause','resume','reset'].includes(packet.action) || !Number.isSafeInteger(packet.frame) || !Number.isSafeInteger(packet.epoch))throw new Error('Invalid host command');\n            this.onCommand(packet,false);break;\n          case 'hash':\n            if(!Number.isSafeInteger(packet.frame) || packet.frame<0 || !Number.isSafeInteger(packet.epoch) || packet.epoch<0 || !/^[a-f0-9]{64}$/.test(packet.hash))throw new Error('Invalid state checksum');\n            this.onHash(packet);break;\n          case 'ping':\n            if(!Number.isFinite(packet.time))throw new Error('Invalid ping');\n            this.send({kind:'pong',time:packet.time});break;\n          case 'pong':\n            if(packet.time===this.lastPing)this.onLatency(Math.round(performance.now()-packet.time));break;\n          default:throw new Error('Unknown peer message');\n        }\n      } catch(error) { this.fail(error); }\n    };\n  }\n  send(packet) {\n    if(this.closed || this.channel?.readyState!=='open')return false;\n    if(this.channel.bufferedAmount>262144){this.fail(new Error('Peer connection is congested.'));return false;}\n    try{this.channel.send(JSON.stringify(packet));return true;}catch(error){this.fail(error);return false;}\n  }\n  markReady() {\n    if(!this.connected || this.ready)return;\n    this.ready=true;this.send({kind:'ready'});this.maybeStart();\n  }\n  maybeStart() {\n    if(this.player===1 && this.ready && this.remoteReady && !this.started) {\n      this.started=true;this.send({kind:'start'});this.onStart();\n    }\n  }\n  fail(error) {\n    if(this.closed)return;\n    this.trace(`Stopped: ${error.message}`);this.close();this.onClose(error.message);\n  }\n  close() {\n    if(this.closed)return;\n    this.closed=true;this.abort.abort();clearTimeout(this.timeout);clearInterval(this.pingTimer);\n    if(this.channel){this.channel.onclose=null;this.channel.onerror=null;this.channel.onmessage=null;this.channel.onopen=null;this.channel.close();}\n    if(this.pc){this.pc.onconnectionstatechange=null;this.pc.close();}\n  }\n}\n", "type": "text/javascript; charset=utf-8"}, "/gameplay/four-player.mjs": {"text": "// MIT License \u2014 Copyright (c) 2026 Rick Gerkin.\n// Emulator extension for the verified US cartridge. Only addresses and original\n// integration code live here; instructions, sprite definitions, and tiles are\n// read from the user's cartridge at runtime.\nconst UPDATE=0xd3b4, MOVE=0xd460, COLLIDE=0xe1d9, DRAW=0xae9d, TILE=0xaee3;\nconst FIELDS=[0x33,0x39,0xf2,0xf6,0xfa,0x301,0x31b,0x335,0x34f,0x7e4,0x7e5,\n  ...Array.from({length:38},(_,i)=>0x91+i*2)];\nconst index=address=>FIELDS.indexOf(address);\nconst reverse=mask=>{let out=0;for(let i=0;i<8;i++)out|=((mask>>i)&1)<<(7-i);return out;};\n\nexport class FourPlayer {\n  constructor(nes, count=4) {\n    if(![3,4].includes(count))throw new Error('Squad mode needs three or four characters');\n    if(nes.fourPlayer)throw new Error('Four-player extension already installed');\n    this.count=count;this.nes=nes;this.masks=[0,0,0,0];this.previous=[0,0];this.traps=[];this.tiles=[[],[]];this.busy=false;\n    this.owners=Array(16).fill(0);\n    this.level=nes.cpu.mem[0x30];this.players=Array.from({length:count-2},()=>this.read());\n    this.players.forEach((state,i)=>{state[index(0x335)]=80+i*24;});\n    this.originalWrite=nes.cpu.write;\n    const extension=this;\n    nes.cpu.write=function(address,value){\n      if(address>=0x388 && address<0x398 && !this.mem[address] && value)extension.owners[address-0x388]=extension.contextPlayer || this.mem[0x448+address-0x388]+1;\n      return extension.originalWrite.call(this,address,value);\n    };\n    this.originalEmulate=nes.cpu.emulate;\n    const engine=this;\n    nes.cpu.emulate=function(){return engine.emulate();};\n    this.originalFrame=nes.ui.writeFrame;\n    nes.ui.writeFrame=buffer=>{this.paint(buffer);this.originalFrame(buffer);};\n    this.originalJSON=nes.toJSON;\n    nes.toJSON=()=>({...this.originalJSON.call(nes),fourPlayer:{version:1,level:this.level,count:this.count,players:this.players,owners:this.owners,previous:this.previous,masks:this.masks}});\n    nes.fourPlayer=this;\n  }\n  read(){return FIELDS.map(a=>this.nes.cpu.mem[a]);}\n  write(state){FIELDS.forEach((a,i)=>{this.nes.cpu.mem[a]=state[i];});}\n  get status(){return this.players.map((p,i)=>({player:i+3,x:p[index(0x335)],y:p[index(0x31b)],state:p[index(0x91)],lives:p[index(0x33)],gameOver:p[index(0x39)],weapon:p[index(0xab)]}));}\n  setInputs(masks){if(masks.length!==this.count || masks.some(mask=>!Number.isInteger(mask)||mask<0||mask>255))throw new Error('Input count must match character count');this.masks=[...masks];}\n  // Invoke a cartridge subroutine as an extra simulation operation, without\n  // advancing video/audio time or disturbing the interrupted CPU context.\n  call(address,{bank,x=1,a=0,setup=()=>{}}={}) {\n    const {cpu,ppu,mmap}=this.nes,m=cpu.mem;\n    const registers=Object.fromEntries(Object.entries(cpu).filter(([,v])=>typeof v==='number'||typeof v==='boolean'));\n    const scratch=m.slice(0,0x18),stack=m.slice(0x1a0,0x200),prior=m.slice(0x7ec,0x7ee),oldBank=m[0x8000];\n    const advance=ppu.advanceDots;\n    this.busy=true;ppu.advanceDots=()=>{};\n    try {\n      cpu.irqRequested=false;cpu.nmiRaised=false;cpu.nmiPending=false;cpu.nmiImmediate=false;\n      cpu.REG_SP=0xff;cpu.REG_X=x;cpu.REG_ACC=a;\n      if(bank!==undefined)mmap.loadRomBank(bank,0x8000);\n      // RTS pops the stored return address and increments it. $6000 is a sentinel.\n      cpu.push(0x5f);cpu.push(0xff);cpu.REG_PC=address-1;setup(m);\n      let instructions=0;\n      while(cpu.REG_PC!==0x5fff) {\n        if(cpu.REG_SP<0xa0)throw new Error('Four-player cartridge stack budget exceeded');\n        if(++instructions>30000)throw new Error('Four-player cartridge routine exceeded its instruction budget');\n        this.originalEmulate.call(cpu);\n      }\n    } finally {\n      mmap.loadRomBank(oldBank,0x8000);m.set(scratch,0);m.set(stack,0x1a0);m.set(prior,0x7ec);\n      Object.assign(cpu,registers);ppu.advanceDots=advance;this.busy=false;\n    }\n  }\n  withPlayer(i,callback) {\n    const saved=this.read(),context=this.contextPlayer;this.contextPlayer=i+3;this.write(this.players[i]);\n    try{callback();this.players[i]=this.read();}finally{this.write(saved);this.contextPlayer=context;}\n  }\n  emulate() {\n    const cpu=this.nes.cpu,m=cpu.mem,pc=cpu.REG_PC+1;\n    if(!this.busy) {\n      const trap=this.traps.at(-1);\n      if(trap && trap.pc===pc && trap.sp===cpu.REG_SP) {\n        this.traps.pop();trap.callback();\n      }\n      if(m[0x18]===5) {\n        // Laser/flame/spread updates consult their owner's position and weapon.\n        // Run those updates against the extra context that created the bullet.\n        if(pc===0xb961 && m[0x8000]===6 && this.owners[cpu.REG_X]>=3) {\n          const owner=this.owners[cpu.REG_X]-3;\n          if(owner<this.players.length)this.withPlayer(owner,()=>this.call(0xb961,{x:cpu.REG_X}));\n          cpu.REG_PC=cpu.pull() | cpu.pull()<<8;\n          return 0;\n        }\n        if(pc===0xcf0a && this.players.some(p=>!p[index(0x39)]))cpu.REG_PC=0xcef6;\n        let callback;\n        if(pc===UPDATE)callback=()=>this.update();\n        else if(pc===COLLIDE)callback=()=>this.collide();\n        else if(pc===DRAW && m[0x8000]===1)callback=()=>this.draw();\n        if(callback) {\n          const sp=cpu.REG_SP;\n          this.traps.push({pc:((m[0x100|((sp+1)&255)] | m[0x100|((sp+2)&255)]<<8)+1)&65535,sp:((sp+2)&255),callback});\n        }\n      }\n    }\n    return this.originalEmulate.call(cpu);\n  }\n  update() {\n    const m=this.nes.cpu.mem;\n    if(this.level!==m[0x30]) {\n      this.level=m[0x30];this.players=this.players.map(old=>{\n        const state=this.read();state[index(0x33)]=old[index(0x33)];state[index(0x39)]=old[index(0x39)];return state;\n      });\n    }\n    const originalScroll=m[0x68];\n    for(let i=0;i<this.players.length;i++) {\n      this.withPlayer(i,()=>{\n        const state=reverse(this.masks[i+2]);m[0xf2]=state;m[0xf6]=state&~this.previous[i];m[0xfa]=state;\n        this.previous[i]=state;m[0xa3]=0;\n        if(!m[0x39])this.call(MOVE);\n      });\n    }\n    const scroll=m[0x68];\n    if(m[0x40]===0) {\n      // Apply the shared camera movement once to every character who did not\n      // cause it. The stock engine already corrected the original two players.\n      for(let i=0;i<this.players.length;i++) {\n        const p=this.players[i];\n        if(!p[index(0xa3)] && scroll) {\n          const addr=m[0x41]===0?0x335:0x31b;\n          p[index(addr)]=(p[index(addr)]+(m[0x41]===0?-scroll:scroll))&255;\n        }\n      }\n      const extra=Math.max(0,scroll-originalScroll);\n      if(extra)for(let i=0;i<2;i++) {\n        const addr=m[0x41]===0?0x334+i:0x31a+i;\n        m[addr]=(m[addr]+(m[0x41]===0?-extra:extra))&255;\n      }\n    }\n  }\n  collide() {\n    const m=this.nes.cpu.mem,savedState=m[0x90];\n    // Reuse the collision routine with the two additional, independent player\n    // contexts. Enemy health, pickups and bullets remain in the same world RAM.\n    try {\n      m[0x90]=3;\n      for(let i=0;i<this.players.length;i++)this.withPlayer(i,()=>{if(!m[0x39])this.call(COLLIDE);});\n    } finally {m[0x90]=savedState;}\n  }\n  draw() {\n    const m=this.nes.cpu.mem,oam=m.slice(0x200,0x300);\n    this.tiles=[[],[]];\n    try {\n      for(let i=0;i<this.players.length;i++)this.withPlayer(i,()=>{\n        if(m[0x39] || !m[0x301])return;\n        m.fill(0xf4,0x200,0x300);\n        this.call(TILE,{bank:1,a:m[0x301],setup:m=>{\n          m[0]=m[0x34f];m[1]=m[0x31b];m[2]=m[0x335];m[4]=0;m[7]=63;\n        }});\n        for(let a=0x200;a<0x300;a+=4)if(m[a]!==0xf4)this.tiles[i].push(Array.from(m.slice(a,a+4)));\n      });\n    } finally {m.set(oam,0x200);}\n  }\n  paint(buffer) {\n    const ppu=this.nes.ppu;\n    if(this.nes.cpu.mem[0x18]!==5 || ppu.f_spVisibility!==1)return;\n    // Extra characters use the cartridge's tile geometry and skin/shadow colors.\n    // Substitute only the colored clothing, independently of enemy palettes.\n    const clothing=[0x50c040,0x30c8f0]; // JSNES pixels are packed BGR.\n    for(let player=0;player<this.players.length;player++)for(const [sy,tile,attr,sx] of this.tiles[player]) {\n      const height=ppu.f_spriteSize?16:8;\n      for(let y=0;y<height;y++)for(let x=0;x<8;x++) {\n        const dx=sx+x,dy=sy+1+y;if(dx<8||dx>=248||dy<8||dy>=232)continue;\n        const py=attr&128?height-1-y:y;\n        const pattern=height===16?((tile&1)*256+(tile&254)+(py>>3)):tile+(ppu.f_spPatternTable?256:0);\n        const color=ppu.ptTile[pattern].pix[(py&7)*8+(attr&64?7-x:x)];if(!color)continue;\n        const at=dy*256+dx;\n        if((attr&32) && (ppu.pixrendered[at]&256))continue;\n        buffer[at]=color===2?clothing[player]:ppu.sprPalette[(attr&3)*4+color];\n      }\n    }\n  }\n  dispose() {\n    const nes=this.nes;nes.cpu.emulate=this.originalEmulate;nes.cpu.write=this.originalWrite;nes.ui.writeFrame=this.originalFrame;nes.toJSON=this.originalJSON;\n    delete nes.fourPlayer;\n  }\n}\n", "type": "text/javascript; charset=utf-8"}, "/vendor/jsnes/src/browser/frame-timer.js": {"text": "// Debug logging, enabled via localStorage.jsnes_debug = 1\nlet debugEnabled = false;\ntry {\n  debugEnabled = !!localStorage.getItem(\"jsnes_debug\");\n} catch {\n  // localStorage not available\n}\n\nconst FPS = 60.098;\n\nexport default class FrameTimer {\n  constructor(props) {\n    // Run at 60 FPS\n    this.onGenerateFrame = props.onGenerateFrame;\n    // Run on animation frame\n    this.onWriteFrame = props.onWriteFrame;\n    this.onAnimationFrame = this.onAnimationFrame.bind(this);\n    this.running = true;\n    this.interval = 1e3 / FPS;\n    this.lastFrameTime = false;\n  }\n\n  start() {\n    this.running = true;\n    this.requestAnimationFrame();\n  }\n\n  stop() {\n    this.running = false;\n    if (this._requestID) window.cancelAnimationFrame(this._requestID);\n    this.lastFrameTime = false;\n  }\n\n  requestAnimationFrame() {\n    this._requestID = window.requestAnimationFrame(this.onAnimationFrame);\n  }\n\n  generateFrame() {\n    this.onGenerateFrame();\n    this.lastFrameTime += this.interval;\n  }\n\n  onAnimationFrame = (time) => {\n    this.requestAnimationFrame();\n    // how many ms after 60fps frame time\n    let excess = time % this.interval;\n\n    // newFrameTime is the current time aligned to 60fps intervals.\n    // i.e. 16.6, 33.3, etc ...\n    let newFrameTime = time - excess;\n\n    // first frame, do nothing\n    if (!this.lastFrameTime) {\n      this.lastFrameTime = newFrameTime;\n      return;\n    }\n\n    let numFrames = Math.round(\n      (newFrameTime - this.lastFrameTime) / this.interval,\n    );\n\n    // This can happen a lot on a 144Hz display\n    if (numFrames === 0) {\n      return;\n    }\n\n    // update display on first frame only\n    this.generateFrame();\n    this.onWriteFrame();\n\n    // we generate additional frames evenly before the next\n    // onAnimationFrame call.\n    // additional frames are generated but not displayed\n    // until next frame draw\n    let timeToNextFrame = this.interval - excess;\n    for (let i = 1; i < numFrames; i++) {\n      setTimeout(\n        () => {\n          this.generateFrame();\n        },\n        (i * timeToNextFrame) / numFrames,\n      );\n    }\n    if (numFrames > 1 && debugEnabled) {\n      console.log(\"SKIP\", numFrames - 1, this.lastFrameTime);\n    }\n  };\n}\n", "type": "text/javascript; charset=utf-8"}, "/vendor/jsnes/src/browser/gamepad.js": {"text": "export default class GamepadController {\n  constructor(options) {\n    this.onButtonDown = options.onButtonDown;\n    this.onButtonUp = options.onButtonUp;\n    this.gamepadState = [];\n    this.buttonCallback = null;\n  }\n\n  disableIfGamepadEnabled = (callback) => {\n    var self = this;\n    return (playerId, buttonId) => {\n      if (!self.gamepadConfig) {\n        return callback(playerId, buttonId);\n      }\n\n      var playerGamepadId = self.gamepadConfig.playerGamepadId;\n      if (!playerGamepadId || !playerGamepadId[playerId - 1]) {\n        // allow callback only if player is not associated to any gamepad\n        return callback(playerId, buttonId);\n      }\n    };\n  };\n\n  _getPlayerNumberFromGamepad = (gamepad) => {\n    if (this.gamepadConfig.playerGamepadId[0] === gamepad.id) {\n      return 1;\n    }\n\n    if (this.gamepadConfig.playerGamepadId[1] === gamepad.id) {\n      return 2;\n    }\n\n    return 1;\n  };\n\n  poll = () => {\n    const gamepads = navigator.getGamepads\n      ? navigator.getGamepads()\n      : navigator.webkitGetGamepads();\n\n    const usedPlayers = [];\n\n    for (let gamepadIndex = 0; gamepadIndex < gamepads.length; gamepadIndex++) {\n      const gamepad = gamepads[gamepadIndex];\n      const previousGamepad = this.gamepadState[gamepadIndex];\n\n      if (!gamepad) {\n        continue;\n      }\n\n      if (!previousGamepad) {\n        this.gamepadState[gamepadIndex] = gamepad;\n        continue;\n      }\n\n      const buttons = gamepad.buttons;\n      const previousButtons = previousGamepad.buttons;\n\n      if (this.buttonCallback) {\n        for (let code = 0; code < gamepad.axes.length; code++) {\n          const axis = gamepad.axes[code];\n          const previousAxis = previousGamepad.axes[code];\n\n          if (axis === -1 && previousAxis !== -1) {\n            this.buttonCallback({\n              gamepadId: gamepad.id,\n              type: \"axis\",\n              code: code,\n              value: axis,\n            });\n          }\n\n          if (axis === 1 && previousAxis !== 1) {\n            this.buttonCallback({\n              gamepadId: gamepad.id,\n              type: \"axis\",\n              code: code,\n              value: axis,\n            });\n          }\n        }\n\n        for (let code = 0; code < buttons.length; code++) {\n          const button = buttons[code];\n          const previousButton = previousButtons[code];\n          if (button.pressed && !previousButton.pressed) {\n            this.buttonCallback({\n              gamepadId: gamepad.id,\n              type: \"button\",\n              code: code,\n            });\n          }\n        }\n      } else if (this.gamepadConfig) {\n        let playerNumber = this._getPlayerNumberFromGamepad(gamepad);\n        if (usedPlayers.length < 2) {\n          if (usedPlayers.indexOf(playerNumber) !== -1) {\n            playerNumber++;\n            if (playerNumber > 2) playerNumber = 1;\n          }\n          usedPlayers.push(playerNumber);\n\n          if (this.gamepadConfig.configs[gamepad.id]) {\n            const configButtons =\n              this.gamepadConfig.configs[gamepad.id].buttons;\n\n            for (let i = 0; i < configButtons.length; i++) {\n              const configButton = configButtons[i];\n              if (configButton.type === \"button\") {\n                const code = configButton.code;\n                const button = buttons[code];\n                const previousButton = previousButtons[code];\n\n                if (button.pressed && !previousButton.pressed) {\n                  this.onButtonDown(playerNumber, configButton.buttonId);\n                } else if (!button.pressed && previousButton.pressed) {\n                  this.onButtonUp(playerNumber, configButton.buttonId);\n                }\n              } else if (configButton.type === \"axis\") {\n                const code = configButton.code;\n                const axis = gamepad.axes[code];\n                const previousAxis = previousGamepad.axes[code];\n\n                if (\n                  axis === configButton.value &&\n                  previousAxis !== configButton.value\n                ) {\n                  this.onButtonDown(playerNumber, configButton.buttonId);\n                }\n\n                if (\n                  axis !== configButton.value &&\n                  previousAxis === configButton.value\n                ) {\n                  this.onButtonUp(playerNumber, configButton.buttonId);\n                }\n              }\n            }\n          }\n        }\n      }\n\n      this.gamepadState[gamepadIndex] = {\n        buttons: buttons.map((b) => {\n          return { pressed: b.pressed };\n        }),\n        axes: gamepad.axes.slice(0),\n      };\n    }\n  };\n\n  promptButton = (f) => {\n    if (!f) {\n      this.buttonCallback = f;\n    } else {\n      this.buttonCallback = (buttonInfo) => {\n        this.buttonCallback = null;\n        f(buttonInfo);\n      };\n    }\n  };\n\n  loadGamepadConfig = () => {\n    var gamepadConfig;\n    try {\n      gamepadConfig = localStorage.getItem(\"gamepadConfig\");\n      if (gamepadConfig) {\n        gamepadConfig = JSON.parse(gamepadConfig);\n      }\n    } catch (e) {\n      console.warn(\"Failed to get gamepadConfig from localStorage.\", e);\n    }\n\n    this.gamepadConfig = gamepadConfig;\n  };\n\n  setGamepadConfig = (gamepadConfig) => {\n    try {\n      localStorage.setItem(\"gamepadConfig\", JSON.stringify(gamepadConfig));\n      this.gamepadConfig = gamepadConfig;\n    } catch (e) {\n      console.warn(\"Failed to set gamepadConfig in localStorage.\", e);\n    }\n  };\n\n  startPolling = () => {\n    if (!(navigator.getGamepads || navigator.webkitGetGamepads)) {\n      return { stop: () => {} };\n    }\n\n    let stopped = false;\n    const loop = () => {\n      if (stopped) return;\n\n      this.poll();\n      requestAnimationFrame(loop);\n    };\n    requestAnimationFrame(loop);\n\n    return {\n      stop: () => {\n        stopped = true;\n      },\n    };\n  };\n}\n", "type": "text/javascript; charset=utf-8"}, "/vendor/jsnes/src/browser/index.js": {"text": "import NES from \"../nes.js\";\nimport Screen from \"./screen.js\";\nimport Speakers from \"./speakers.js\";\nimport FrameTimer from \"./frame-timer.js\";\nimport KeyboardController from \"./keyboard.js\";\nimport GamepadController from \"./gamepad.js\";\n\n// Debug logging, enabled via localStorage.jsnes_debug = 1\nlet debugEnabled = false;\ntry {\n  debugEnabled = !!localStorage.getItem(\"jsnes_debug\");\n} catch {\n  // localStorage not available\n}\nfunction debug(...args) {\n  if (debugEnabled) console.log(...args);\n}\n\n/**\n * Browser-based NES emulator that handles canvas rendering, audio output,\n * keyboard/gamepad input, and frame timing.\n *\n * Usage:\n *   const browser = new jsnes.Browser({\n *     container: document.getElementById(\"nes\"),\n *     romData: romData,\n *     onError: (e) => console.error(e),\n *   });\n *\n * If romData is omitted, call browser.loadROM(data) then browser.start().\n */\nexport default class Browser {\n  constructor(options = {}) {\n    this._options = options;\n\n    // Create screen (creates <canvas> inside container)\n    this._screen = new Screen(options.container, {\n      onMouseDown: (x, y) => {\n        this.nes.zapperMove(x, y);\n        this.nes.zapperFireDown();\n      },\n      onMouseUp: () => {\n        this.nes.zapperFireUp();\n      },\n    });\n    this._screen.fitInParent();\n\n    // Create speakers\n    this._speakers = new Speakers({\n      onBufferUnderrun: () => {\n        // Generate extra frames so audio remains consistent. This happens for\n        // a variety of reasons:\n        // - Frame rate is not quite 60fps, so sometimes buffer empties\n        // - Page is not visible, so requestAnimationFrame doesn't get fired.\n        //   In this case emulator still runs at full speed, but timing is\n        //   done by audio instead of requestAnimationFrame.\n        // - System can't run emulator at full speed. In this case it'll stop\n        //    firing requestAnimationFrame.\n        debug(\"Buffer underrun, running extra frames to catch up\");\n\n        // The NES produces ~800 samples per frame at 48kHz. Run two frames\n        // to ensure the worklet buffer is refilled.\n        this._frameTimer.generateFrame();\n        this._frameTimer.generateFrame();\n      },\n    });\n\n    // Create NES\n    this.nes = new NES({\n      onFrame: this._screen.setBuffer,\n      onStatusUpdate: debug,\n      onAudioSample: this._speakers.writeSample,\n      onBatteryRamWrite: options.onBatteryRamWrite || (() => {}),\n      sampleRate: this._speakers.getSampleRate(),\n    });\n\n    // Create frame timer\n    this._frameTimer = new FrameTimer({\n      onGenerateFrame: () => {\n        try {\n          this.nes.frame();\n          this._speakers.flush();\n        } catch (e) {\n          this.stop();\n          if (this._options.onError) {\n            this._options.onError(e);\n          }\n        }\n      },\n      onWriteFrame: this._screen.writeBuffer,\n    });\n\n    // Set up gamepad and keyboard\n    this.gamepad = new GamepadController({\n      onButtonDown: this.nes.buttonDown,\n      onButtonUp: this.nes.buttonUp,\n    });\n    this.gamepad.loadGamepadConfig();\n    this._gamepadPolling = this.gamepad.startPolling();\n\n    this.keyboard = new KeyboardController({\n      onButtonDown: this.gamepad.disableIfGamepadEnabled(this.nes.buttonDown),\n      onButtonUp: this.gamepad.disableIfGamepadEnabled(this.nes.buttonUp),\n    });\n    this.keyboard.loadKeys();\n\n    // Bind keyboard events\n    document.addEventListener(\"keydown\", this.keyboard.handleKeyDown);\n    document.addEventListener(\"keyup\", this.keyboard.handleKeyUp);\n    document.addEventListener(\"keypress\", this.keyboard.handleKeyPress);\n\n    // Load ROM and start if provided\n    if (options.romData) {\n      this.nes.loadROM(options.romData);\n      this.start();\n    }\n  }\n\n  start() {\n    this._frameTimer.start();\n    this._speakers.start();\n    this._fpsInterval = setInterval(() => {\n      debug(`FPS: ${this.nes.getFPS()}`);\n    }, 1000);\n  }\n\n  stop() {\n    this._frameTimer.stop();\n    this._speakers.stop();\n    clearInterval(this._fpsInterval);\n  }\n\n  loadROM(data) {\n    this.stop();\n    this.nes.loadROM(data);\n    this.start();\n  }\n\n  /**\n   * Fill parent element with screen. Call if parent element changes size.\n   */\n  fitInParent() {\n    this._screen.fitInParent();\n  }\n\n  screenshot() {\n    return this._screen.screenshot();\n  }\n\n  /**\n   * Clean up all resources: stop emulation, remove event listeners, remove canvas.\n   */\n  destroy() {\n    this.stop();\n    document.removeEventListener(\"keydown\", this.keyboard.handleKeyDown);\n    document.removeEventListener(\"keyup\", this.keyboard.handleKeyUp);\n    document.removeEventListener(\"keypress\", this.keyboard.handleKeyPress);\n    this._gamepadPolling.stop();\n    this._screen.destroy();\n  }\n\n  /**\n   * Load ROM data from a URL via XHR.\n   */\n  static loadROMFromURL(url, callback) {\n    var req = new XMLHttpRequest();\n    req.open(\"GET\", url);\n    req.overrideMimeType(\"text/plain; charset=x-user-defined\");\n    req.onerror = () =>\n      callback(new Error(`Error loading ${url}: ${req.statusText}`));\n    req.onload = function () {\n      if (this.status === 200) {\n        callback(null, this.responseText);\n      } else if (this.status === 0) {\n        // Aborted, ignore\n      } else {\n        req.onerror();\n      }\n    };\n    req.send();\n    return req;\n  }\n}\n", "type": "text/javascript; charset=utf-8"}, "/vendor/jsnes/src/browser/keyboard.js": {"text": "import Controller from \"../controller.js\";\n\n// Mapping keyboard code to [controller, button]\nconst KEYS = {\n  88: [1, Controller.BUTTON_A, \"X\"], // X\n  89: [1, Controller.BUTTON_B, \"Y\"], // Y (Central European keyboard)\n  90: [1, Controller.BUTTON_B, \"Z\"], // Z\n  17: [1, Controller.BUTTON_SELECT, \"Right Ctrl\"], // Right Ctrl\n  13: [1, Controller.BUTTON_START, \"Enter\"], // Enter\n  38: [1, Controller.BUTTON_UP, \"Up\"], // Up\n  40: [1, Controller.BUTTON_DOWN, \"Down\"], // Down\n  37: [1, Controller.BUTTON_LEFT, \"Left\"], // Left\n  39: [1, Controller.BUTTON_RIGHT, \"Right\"], // Right\n  83: [1, Controller.BUTTON_TURBO_A, \"S\"], // S\n  65: [1, Controller.BUTTON_TURBO_B, \"A\"], // A\n  103: [2, Controller.BUTTON_A, \"Num-7\"], // Num-7\n  105: [2, Controller.BUTTON_B, \"Num-9\"], // Num-9\n  99: [2, Controller.BUTTON_SELECT, \"Num-3\"], // Num-3\n  97: [2, Controller.BUTTON_START, \"Num-1\"], // Num-1\n  104: [2, Controller.BUTTON_UP, \"Num-8\"], // Num-8\n  98: [2, Controller.BUTTON_DOWN, \"Num-2\"], // Num-2\n  100: [2, Controller.BUTTON_LEFT, \"Num-4\"], // Num-4\n  102: [2, Controller.BUTTON_RIGHT, \"Num-6\"], // Num-6\n};\n\nexport default class KeyboardController {\n  constructor(options) {\n    this.onButtonDown = options.onButtonDown;\n    this.onButtonUp = options.onButtonUp;\n  }\n\n  loadKeys = () => {\n    var keys;\n    try {\n      keys = localStorage.getItem(\"keys\");\n      if (keys) {\n        keys = JSON.parse(keys);\n      }\n    } catch (e) {\n      console.warn(\"Failed to get keys from localStorage.\", e);\n    }\n\n    this.keys = keys || KEYS;\n  };\n\n  setKeys = (newKeys) => {\n    try {\n      localStorage.setItem(\"keys\", JSON.stringify(newKeys));\n      this.keys = newKeys;\n    } catch (e) {\n      console.warn(\"Failed to set keys in localStorage.\", e);\n    }\n  };\n\n  handleKeyDown = (e) => {\n    var key = this.keys[e.keyCode];\n    if (key) {\n      this.onButtonDown(key[0], key[1]);\n      e.preventDefault();\n    }\n  };\n\n  handleKeyUp = (e) => {\n    var key = this.keys[e.keyCode];\n    if (key) {\n      this.onButtonUp(key[0], key[1]);\n      e.preventDefault();\n    }\n  };\n\n  handleKeyPress = (e) => {\n    if (this.keys[e.keyCode]) {\n      e.preventDefault();\n    }\n  };\n}\n", "type": "text/javascript; charset=utf-8"}, "/vendor/jsnes/src/browser/screen.js": {"text": "const SCREEN_WIDTH = 256;\nconst SCREEN_HEIGHT = 240;\n\nexport default class Screen {\n  constructor(container, options = {}) {\n    this.onMouseDown = options.onMouseDown;\n    this.onMouseUp = options.onMouseUp;\n\n    // Create canvas element\n    this.canvas = document.createElement(\"canvas\");\n    this.canvas.width = SCREEN_WIDTH;\n    this.canvas.height = SCREEN_HEIGHT;\n    this.canvas.style.imageRendering = \"pixelated\";\n    this.canvas.style.imageRendering = \"crisp-edges\";\n    container.appendChild(this.canvas);\n\n    // Mouse events for Zapper support\n    this._handleMouseDown = (e) => {\n      if (!this.onMouseDown) return;\n      // Make coordinates unscaled\n      let scale = SCREEN_WIDTH / parseFloat(this.canvas.style.width);\n      let rect = this.canvas.getBoundingClientRect();\n      let x = Math.round((e.clientX - rect.left) * scale);\n      let y = Math.round((e.clientY - rect.top) * scale);\n      this.onMouseDown(x, y);\n    };\n    this._handleMouseUp = () => {\n      if (this.onMouseUp) this.onMouseUp();\n    };\n    this.canvas.addEventListener(\"mousedown\", this._handleMouseDown);\n    this.canvas.addEventListener(\"mouseup\", this._handleMouseUp);\n\n    this._initCanvas();\n  }\n\n  _initCanvas() {\n    this.context = this.canvas.getContext(\"2d\");\n    this.imageData = this.context.getImageData(\n      0,\n      0,\n      SCREEN_WIDTH,\n      SCREEN_HEIGHT,\n    );\n\n    this.context.fillStyle = \"black\";\n    // set alpha to opaque\n    this.context.fillRect(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT);\n\n    // buffer to write on next animation frame\n    this.buf = new ArrayBuffer(this.imageData.data.length);\n    // Get the canvas buffer in 8bit and 32bit\n    this.buf8 = new Uint8ClampedArray(this.buf);\n    this.buf32 = new Uint32Array(this.buf);\n\n    // Set alpha\n    for (var i = 0; i < this.buf32.length; ++i) {\n      this.buf32[i] = 0xff000000;\n    }\n  }\n\n  setBuffer = (buffer) => {\n    for (var y = 0; y < SCREEN_HEIGHT; ++y) {\n      for (var x = 0; x < SCREEN_WIDTH; ++x) {\n        var i = y * 256 + x;\n        // Convert pixel from NES BGR to canvas ABGR\n        this.buf32[i] = 0xff000000 | buffer[i]; // Full alpha\n      }\n    }\n  };\n\n  writeBuffer = () => {\n    this.imageData.data.set(this.buf8);\n    this.context.putImageData(this.imageData, 0, 0);\n  };\n\n  fitInParent = () => {\n    let parent = this.canvas.parentNode;\n    let parentWidth = parent.clientWidth;\n    let parentHeight = parent.clientHeight;\n    let parentRatio = parentWidth / parentHeight;\n    let desiredRatio = SCREEN_WIDTH / SCREEN_HEIGHT;\n    if (desiredRatio < parentRatio) {\n      this.canvas.style.width = `${Math.round(parentHeight * desiredRatio)}px`;\n      this.canvas.style.height = `${parentHeight}px`;\n    } else {\n      this.canvas.style.width = `${parentWidth}px`;\n      this.canvas.style.height = `${Math.round(parentWidth / desiredRatio)}px`;\n    }\n  };\n\n  screenshot() {\n    var img = new Image();\n    img.src = this.canvas.toDataURL(\"image/png\");\n    return img;\n  }\n\n  destroy() {\n    this.canvas.removeEventListener(\"mousedown\", this._handleMouseDown);\n    this.canvas.removeEventListener(\"mouseup\", this._handleMouseUp);\n    this.canvas.parentNode.removeChild(this.canvas);\n  }\n}\n", "type": "text/javascript; charset=utf-8"}, "/vendor/jsnes/src/browser/speakers.js": {"text": "// AudioWorklet processor code, inlined as a string so it can be loaded via\n// Blob URL without bundler-specific imports (e.g. ?raw). This avoids\n// requiring webpack/Vite to import the module source.\n//\n// The processor receives stereo samples from the main thread via MessagePort\n// and buffers them in a circular Float32Array for playback in process().\nconst workletCode = `\nclass NESAudioProcessor extends AudioWorkletProcessor {\n  constructor() {\n    super();\n    // Circular buffer sized to hold ~170ms of audio at 48kHz (8192 samples).\n    this.capacity = 8192;\n    this.bufferL = new Float32Array(this.capacity);\n    this.bufferR = new Float32Array(this.capacity);\n    this.readPos = 0;\n    this.writePos = 0;\n    this.count = 0;\n\n    this.port.onmessage = (e) => {\n      if (e.data.type === \"samples\") {\n        const left = e.data.left;\n        const right = e.data.right;\n        const len = left.length;\n\n        // If adding these samples would overflow, drop oldest to make room\n        if (this.count + len > this.capacity) {\n          const drop = this.count + len - this.capacity;\n          this.readPos = (this.readPos + drop) % this.capacity;\n          this.count -= drop;\n        }\n\n        for (let i = 0; i < len; i++) {\n          this.bufferL[this.writePos] = left[i];\n          this.bufferR[this.writePos] = right[i];\n          this.writePos = (this.writePos + 1) % this.capacity;\n        }\n        this.count += len;\n      }\n    };\n  }\n\n  process(inputs, outputs) {\n    const output = outputs[0];\n    if (!output || output.length < 2) return true;\n\n    const outL = output[0];\n    const outR = output[1];\n    const size = outL.length;\n\n    if (this.count < size) {\n      for (let i = 0; i < this.count; i++) {\n        outL[i] = this.bufferL[this.readPos];\n        outR[i] = this.bufferR[this.readPos];\n        this.readPos = (this.readPos + 1) % this.capacity;\n      }\n      for (let i = this.count; i < size; i++) {\n        outL[i] = 0;\n        outR[i] = 0;\n      }\n      this.count = 0;\n      this.port.postMessage({ type: \"underrun\" });\n    } else {\n      for (let i = 0; i < size; i++) {\n        outL[i] = this.bufferL[this.readPos];\n        outR[i] = this.bufferR[this.readPos];\n        this.readPos = (this.readPos + 1) % this.capacity;\n      }\n      this.count -= size;\n    }\n\n    return true;\n  }\n}\n\nregisterProcessor(\"nes-audio-processor\", NESAudioProcessor);\n`;\n\n// How many samples to batch before posting to the worklet. Posting every\n// single sample individually would be too much MessagePort overhead.\n// 128 matches the AudioWorklet render quantum size.\nconst BATCH_SIZE = 128;\n\nexport default class Speakers {\n  constructor({ onBufferUnderrun }) {\n    this.onBufferUnderrun = onBufferUnderrun;\n    this.audioCtx = null;\n    this.node = null;\n    this.batchL = new Float32Array(BATCH_SIZE);\n    this.batchR = new Float32Array(BATCH_SIZE);\n    this.batchPos = 0;\n  }\n\n  getSampleRate() {\n    if (this.audioCtx) {\n      return this.audioCtx.sampleRate;\n    }\n    return 44100;\n  }\n\n  // start() is async because audioWorklet.addModule() returns a promise.\n  // Callers may fire-and-forget \u2014 the node will be null until the worklet\n  // loads, and writeSample() silently drops samples during that brief window.\n  async start() {\n    if (!window.AudioContext) {\n      return;\n    }\n    this.audioCtx = new window.AudioContext();\n\n    const blob = new Blob([workletCode], { type: \"application/javascript\" });\n    const workletUrl = URL.createObjectURL(blob);\n    await this.audioCtx.audioWorklet.addModule(workletUrl);\n    URL.revokeObjectURL(workletUrl);\n\n    this.node = new AudioWorkletNode(this.audioCtx, \"nes-audio-processor\", {\n      outputChannelCount: [2],\n    });\n\n    this.node.port.onmessage = (e) => {\n      if (e.data.type === \"underrun\" && this.onBufferUnderrun) {\n        this.onBufferUnderrun();\n      }\n    };\n\n    this.node.connect(this.audioCtx.destination);\n\n    // Chrome and other browsers require a user gesture before AudioContext can\n    // start. If suspended, resume on the first user interaction.\n    // See https://github.com/bfirsh/jsnes/issues/368\n    if (this.audioCtx.state === \"suspended\") {\n      this._resumeOnInteraction = () => {\n        if (this.audioCtx) {\n          this.audioCtx.resume();\n        }\n        this._removeResumeListeners();\n      };\n      document.addEventListener(\"keydown\", this._resumeOnInteraction);\n      document.addEventListener(\"mousedown\", this._resumeOnInteraction);\n      document.addEventListener(\"touchstart\", this._resumeOnInteraction);\n    }\n  }\n\n  _removeResumeListeners() {\n    if (this._resumeOnInteraction) {\n      document.removeEventListener(\"keydown\", this._resumeOnInteraction);\n      document.removeEventListener(\"mousedown\", this._resumeOnInteraction);\n      document.removeEventListener(\"touchstart\", this._resumeOnInteraction);\n      this._resumeOnInteraction = null;\n    }\n  }\n\n  stop() {\n    this._removeResumeListeners();\n    if (this.node) {\n      this.node.disconnect(this.audioCtx.destination);\n      this.node = null;\n    }\n    if (this.audioCtx) {\n      this.audioCtx.close().catch((e) => console.error(e));\n      this.audioCtx = null;\n    }\n    this.batchPos = 0;\n  }\n\n  writeSample = (left, right) => {\n    if (!this.node) return;\n\n    this.batchL[this.batchPos] = left;\n    this.batchR[this.batchPos] = right;\n    this.batchPos++;\n\n    if (this.batchPos >= BATCH_SIZE) {\n      this.node.port.postMessage({\n        type: \"samples\",\n        left: this.batchL.slice(),\n        right: this.batchR.slice(),\n      });\n      this.batchPos = 0;\n    }\n  };\n\n  // Flush any remaining batched samples to the worklet. Called after each\n  // frame to ensure partial batches are sent promptly.\n  flush() {\n    if (this.batchPos > 0 && this.node) {\n      this.node.port.postMessage({\n        type: \"samples\",\n        left: this.batchL.slice(0, this.batchPos),\n        right: this.batchR.slice(0, this.batchPos),\n      });\n      this.batchPos = 0;\n    }\n  }\n}\n", "type": "text/javascript; charset=utf-8"}, "/vendor/jsnes/src/controller.js": {"text": "import { toJSON, fromJSON } from \"./utils.js\";\n\nclass Controller {\n  static BUTTON_A = 0;\n  static BUTTON_B = 1;\n  static BUTTON_SELECT = 2;\n  static BUTTON_START = 3;\n  static BUTTON_UP = 4;\n  static BUTTON_DOWN = 5;\n  static BUTTON_LEFT = 6;\n  static BUTTON_RIGHT = 7;\n  // Turbo buttons rapidly toggle A/B each frame while held, simulating the\n  // extra buttons on the NES Advantage and dogbone controllers.\n  static BUTTON_TURBO_A = 8;\n  static BUTTON_TURBO_B = 9;\n\n  static JSON_PROPERTIES = [\n    \"state\",\n    \"baseA\",\n    \"baseB\",\n    \"turboA\",\n    \"turboB\",\n    \"turboToggle\",\n  ];\n\n  constructor() {\n    this.state = new Array(8);\n    for (let i = 0; i < this.state.length; i++) {\n      this.state[i] = 0x40;\n    }\n    // Track the non-turbo (\"base\") state of A and B so we can restore them\n    // when turbo is released while the regular button is still held.\n    this.baseA = 0x40;\n    this.baseB = 0x40;\n    this.turboA = false;\n    this.turboB = false;\n    this.turboToggle = false;\n  }\n\n  buttonDown(key) {\n    if (key === Controller.BUTTON_TURBO_A) {\n      this.turboA = true;\n    } else if (key === Controller.BUTTON_TURBO_B) {\n      this.turboB = true;\n    } else {\n      this.state[key] = 0x41;\n      if (key === Controller.BUTTON_A) this.baseA = 0x41;\n      if (key === Controller.BUTTON_B) this.baseB = 0x41;\n    }\n  }\n\n  buttonUp(key) {\n    if (key === Controller.BUTTON_TURBO_A) {\n      this.turboA = false;\n      this.state[Controller.BUTTON_A] = this.baseA;\n    } else if (key === Controller.BUTTON_TURBO_B) {\n      this.turboB = false;\n      this.state[Controller.BUTTON_B] = this.baseB;\n    } else {\n      this.state[key] = 0x40;\n      if (key === Controller.BUTTON_A) this.baseA = 0x40;\n      if (key === Controller.BUTTON_B) this.baseB = 0x40;\n    }\n  }\n\n  // Called once per frame to toggle turbo button states. Produces a ~30 Hz\n  // press rate at 60 FPS, matching the fast end of the NES Advantage's\n  // adjustable turbo range.\n  clock() {\n    if (!this.turboA && !this.turboB) return;\n    this.turboToggle = !this.turboToggle;\n    if (this.turboA) {\n      this.state[Controller.BUTTON_A] = this.turboToggle ? 0x41 : 0x40;\n    }\n    if (this.turboB) {\n      this.state[Controller.BUTTON_B] = this.turboToggle ? 0x41 : 0x40;\n    }\n  }\n\n  toJSON() {\n    return toJSON(this);\n  }\n\n  fromJSON(s) {\n    fromJSON(this, s);\n  }\n}\n\nexport default Controller;\n", "type": "text/javascript; charset=utf-8"}, "/vendor/jsnes/src/cpu.js": {"text": "import { fromJSON, toJSON } from \"./utils.js\";\n\n// ============================================================================\n// 6502 opcode table\n// ============================================================================\n//\n// The NES's CPU is a MOS 6502 variant (the Ricoh 2A03 on NTSC consoles,\n// 2A07 on PAL). Like any CPU, it runs machine code by repeatedly fetching\n// a byte from memory, decoding what that byte means, and executing the\n// corresponding operation \u2014 the classic fetch-decode-execute loop.\n//\n// On the 6502, every (operation, addressing mode) pair is assigned its own\n// unique 1-byte opcode. For example, \"LDA\" (Load Accumulator) has eight\n// different opcode bytes because it supports eight addressing modes \u2014 one\n// for \"load from a fixed 2-byte address\", one for \"load from a zero-page\n// address + X\", and so on. That gives a total of 256 possible opcode bytes,\n// of which the official 6502 defines 151; another ~80 are \"unofficial\"\n// opcodes (see below); the rest are unused and would hang a real CPU.\n//\n// This file's emulate() method implements the fetch-decode-execute loop for\n// a single CPU instruction. OPCODE_TABLE is the *decode* step: given the\n// opcode byte we just fetched, it tells emulate() everything it needs to\n// know before running the instruction:\n//\n//   ins    - which instruction to execute (INS_*). Used as the switch key\n//            in the execute phase of emulate().\n//   mode   - which addressing mode to use to find the operand (ADDR_*).\n//            Used as the switch key in the addressing phase of emulate().\n//   size   - how many bytes the instruction occupies in memory (1-3),\n//            so emulate() knows how far to advance the program counter.\n//   cycles - base cycle count. Some instructions pay an extra cycle when\n//            an indexed addressing mode crosses a 256-byte \"page\" boundary\n//            (since the 6502 has to do an extra bus cycle to correct the\n//            high byte of the address), and the execute switch adds that\n//            extra cycle where appropriate.\n//\n// OPCODE_TABLE is defined as a plain object literal below, keyed by the\n// raw opcode byte (0-255). Unassigned bytes are simply absent; at dispatch\n// time the lookup returns `undefined`, which is then replaced with a\n// shared INVALID_OPCODE sentinel so that invalid opcodes fall through to\n// the execute switch's default case and throw.\n//\n// The INS_* and ADDR_* numeric values here must match the `case N:` labels\n// in the two switches in emulate(). If you ever renumber these, update\n// both switches in lockstep.\n\n// ----------------------------------------------------------------------------\n// Addressing modes\n// ----------------------------------------------------------------------------\n//\n// The 6502 has 13 addressing modes \u2014 different ways of specifying where an\n// instruction's operand lives. Some modes take a literal value, some read\n// from a fixed memory address, some compute an address from a base plus an\n// index register (X or Y), and some dereference a pointer stored in memory.\n//\n// The numeric values here are used as `case` labels in the addressing-mode\n// switch at the top of emulate(), which computes the final effective\n// address (or loads the literal value) for each instruction before the\n// instruction itself runs. The code in that switch is the authoritative\n// source for what each mode actually does on the bus, including the\n// sometimes-tricky \"dummy reads\" the real 6502 performs on indexed modes.\n//\n// Notation below: $XX means a 1-byte value (0-$FF), $XXXX means a 2-byte\n// value (0-$FFFF). \"Zero page\" is the first 256 bytes of memory ($0000-\n// $00FF), which the 6502 can address with a single byte \u2014 giving faster\n// and smaller code than full 16-bit addresses.\n//\n// See https://www.nesdev.org/wiki/CPU_addressing_modes\n\nconst ADDR_ZP = 0; //          Zero page         \u2014 operand at $00XX\nconst ADDR_REL = 1; //         Relative          \u2014 PC + signed 8-bit offset (branches)\nconst ADDR_IMP = 2; //         Implied           \u2014 no operand (e.g. CLC, RTS, TAX)\nconst ADDR_ABS = 3; //         Absolute          \u2014 operand at $XXXX (any address)\nconst ADDR_ACC = 4; //         Accumulator       \u2014 operand is the A register itself\nconst ADDR_IMM = 5; //         Immediate         \u2014 operand is a literal byte (LDA #$42)\nconst ADDR_ZPX = 6; //         Zero page,X       \u2014 operand at ($XX + X) & $FF\nconst ADDR_ZPY = 7; //         Zero page,Y       \u2014 operand at ($XX + Y) & $FF\nconst ADDR_ABSX = 8; //        Absolute,X        \u2014 operand at $XXXX + X\nconst ADDR_ABSY = 9; //        Absolute,Y        \u2014 operand at $XXXX + Y\nconst ADDR_PREIDXIND = 10; //  (Indirect,X)      \u2014 pointer at ($XX + X) in zero page\nconst ADDR_POSTIDXIND = 11; // (Indirect),Y      \u2014 pointer at $XX in zero page, then + Y\nconst ADDR_INDABS = 12; //     Indirect absolute \u2014 pointer at $XXXX (JMP indirect only)\n\n// ----------------------------------------------------------------------------\n// Instructions\n// ----------------------------------------------------------------------------\n//\n// The 6502 has 56 official instructions, each conventionally referred to\n// by a 3-letter mnemonic (LDA, STA, JMP, etc.). Most instructions support\n// several addressing modes, so one mnemonic usually maps to several opcode\n// bytes \u2014 which is why OPCODE_TABLE below has multiple entries per\n// mnemonic (e.g. LDA has eight, one for each addressing mode it supports).\n//\n// Each INS_* here is an internal identifier used as the `case` label in\n// the execute switch in emulate(). The ordering and numeric values are\n// arbitrary but must stay in sync with that switch.\n//\n// NOTE: the NES's 2A03/2A07 CPU omits the 6502's BCD (binary-coded decimal)\n// mode. The CLD / SED instructions still exist and toggle the D flag, but\n// the D flag has no effect on ADC/SBC. That's why the CLD/SED handlers in\n// emulate() look like no-ops aside from flipping the flag.\n//\n// See https://www.nesdev.org/wiki/CPU for a per-instruction reference.\n\n// Arithmetic & logic\nconst INS_ADC = 0; //  ADC \u2014 Add memory to accumulator with carry\nconst INS_AND = 1; //  AND \u2014 Bitwise AND memory with accumulator\nconst INS_ASL = 2; //  ASL \u2014 Arithmetic shift left (top bit \u2192 carry)\n// Branches \u2014 each tests one status flag and jumps relative to PC if it matches\nconst INS_BCC = 3; //  BCC \u2014 Branch if carry clear\nconst INS_BCS = 4; //  BCS \u2014 Branch if carry set\nconst INS_BEQ = 5; //  BEQ \u2014 Branch if equal (zero flag set)\nconst INS_BIT = 6; //  BIT \u2014 Bit test: N \u2190 M.7, V \u2190 M.6, Z \u2190 (A & M) == 0\nconst INS_BMI = 7; //  BMI \u2014 Branch if minus (negative flag set)\nconst INS_BNE = 8; //  BNE \u2014 Branch if not equal (zero flag clear)\nconst INS_BPL = 9; //  BPL \u2014 Branch if plus (negative flag clear)\nconst INS_BRK = 10; // BRK \u2014 Software interrupt (pushes PC+2 and status, jumps via $FFFE)\nconst INS_BVC = 11; // BVC \u2014 Branch if overflow clear\nconst INS_BVS = 12; // BVS \u2014 Branch if overflow set\n// Flag clears\nconst INS_CLC = 13; // CLC \u2014 Clear carry flag\nconst INS_CLD = 14; // CLD \u2014 Clear decimal flag (no effect on NES, see note above)\nconst INS_CLI = 15; // CLI \u2014 Clear interrupt disable flag\nconst INS_CLV = 16; // CLV \u2014 Clear overflow flag\n// Compares \u2014 like subtract, but only set flags (don't modify the register)\nconst INS_CMP = 17; // CMP \u2014 Compare memory with accumulator\nconst INS_CPX = 18; // CPX \u2014 Compare memory with X\nconst INS_CPY = 19; // CPY \u2014 Compare memory with Y\n// Decrements\nconst INS_DEC = 20; // DEC \u2014 Decrement memory by one\nconst INS_DEX = 21; // DEX \u2014 Decrement X by one\nconst INS_DEY = 22; // DEY \u2014 Decrement Y by one\n// XOR\nconst INS_EOR = 23; // EOR \u2014 Bitwise exclusive-OR memory with accumulator\n// Increments\nconst INS_INC = 24; // INC \u2014 Increment memory by one\nconst INS_INX = 25; // INX \u2014 Increment X by one\nconst INS_INY = 26; // INY \u2014 Increment Y by one\n// Jumps\nconst INS_JMP = 27; // JMP \u2014 Unconditional jump\nconst INS_JSR = 28; // JSR \u2014 Jump to subroutine (pushes return address first)\n// Loads\nconst INS_LDA = 29; // LDA \u2014 Load accumulator from memory\nconst INS_LDX = 30; // LDX \u2014 Load X from memory\nconst INS_LDY = 31; // LDY \u2014 Load Y from memory\n// Shift\nconst INS_LSR = 32; // LSR \u2014 Logical shift right (bottom bit \u2192 carry)\n// No-op\nconst INS_NOP = 33; // NOP \u2014 No operation\n// OR\nconst INS_ORA = 34; // ORA \u2014 Bitwise OR memory with accumulator\n// Stack pushes/pulls (\"pull\" is the 6502 term for \"pop\")\nconst INS_PHA = 35; // PHA \u2014 Push accumulator onto stack\nconst INS_PHP = 36; // PHP \u2014 Push processor status onto stack\nconst INS_PLA = 37; // PLA \u2014 Pull accumulator from stack\nconst INS_PLP = 38; // PLP \u2014 Pull processor status from stack\n// Rotates (through carry)\nconst INS_ROL = 39; // ROL \u2014 Rotate left through carry (C \u2192 bit 0, bit 7 \u2192 C)\nconst INS_ROR = 40; // ROR \u2014 Rotate right through carry (C \u2192 bit 7, bit 0 \u2192 C)\n// Returns\nconst INS_RTI = 41; // RTI \u2014 Return from interrupt (pulls status and PC)\nconst INS_RTS = 42; // RTS \u2014 Return from subroutine (pulls PC)\n// Subtract\nconst INS_SBC = 43; // SBC \u2014 Subtract memory from accumulator with borrow\n// Flag sets\nconst INS_SEC = 44; // SEC \u2014 Set carry flag\nconst INS_SED = 45; // SED \u2014 Set decimal flag (no effect on NES, see note above)\nconst INS_SEI = 46; // SEI \u2014 Set interrupt disable flag\n// Stores\nconst INS_STA = 47; // STA \u2014 Store accumulator to memory\nconst INS_STX = 48; // STX \u2014 Store X to memory\nconst INS_STY = 49; // STY \u2014 Store Y to memory\n// Register transfers\nconst INS_TAX = 50; // TAX \u2014 Transfer accumulator to X\nconst INS_TAY = 51; // TAY \u2014 Transfer accumulator to Y\nconst INS_TSX = 52; // TSX \u2014 Transfer stack pointer to X\nconst INS_TXA = 53; // TXA \u2014 Transfer X to accumulator\nconst INS_TXS = 54; // TXS \u2014 Transfer X to stack pointer\nconst INS_TYA = 55; // TYA \u2014 Transfer Y to accumulator\n\n// ----------------------------------------------------------------------------\n// Unofficial opcodes\n// ----------------------------------------------------------------------------\n//\n// The 6502's instruction decoder is a combinational circuit rather than a\n// lookup table, and about 80 of the 256 possible opcode bytes decode to\n// instructions that weren't part of the official instruction set but still\n// do *something* \u2014 usually a combination of two official instructions that\n// happen to share hardware (e.g. SLO = \"ASL then ORA\"). Some shipped NES\n// games, and most CPU test ROMs (including nestest and AccuracyCoin), use\n// them deliberately, so a correct NES emulator has to implement them.\n//\n// See https://www.nesdev.org/wiki/Programming_with_unofficial_opcodes\n\n// Combined arithmetic/logic on the accumulator (immediate operand only)\nconst INS_ALR = 56; // ALR (ASR) \u2014 AND then LSR:  A = (A & #imm) >> 1\nconst INS_ANC = 57; // ANC        \u2014 AND, but also copy result's bit 7 into carry\nconst INS_ARR = 58; // ARR        \u2014 AND then ROR, with peculiar N/V/C side effects\nconst INS_AXS = 59; // AXS (SBX)  \u2014 X = (A & X) - #imm (like CMP, but stores result)\n// Combined load/store\nconst INS_LAX = 60; // LAX \u2014 Load A and X from memory simultaneously\nconst INS_SAX = 61; // SAX \u2014 Store (A & X) to memory\n// Read-modify-write combos: each does an RMW on memory then an A-side op\nconst INS_DCP = 62; // DCP \u2014 DEC memory then CMP with A\nconst INS_ISC = 63; // ISC (ISB) \u2014 INC memory then SBC from A\nconst INS_RLA = 64; // RLA \u2014 ROL memory then AND with A\nconst INS_RRA = 65; // RRA \u2014 ROR memory then ADC with A\nconst INS_SLO = 66; // SLO \u2014 ASL memory then ORA with A\nconst INS_SRE = 67; // SRE \u2014 LSR memory then EOR with A\n// Multi-byte NOPs. These consume extra bytes and (for IGN) still perform a\n// dummy memory read, but don't otherwise affect state. Games occasionally\n// use them for precise cycle-count padding.\nconst INS_SKB = 68; // SKB \u2014 2-byte NOP (skips an immediate byte)\nconst INS_IGN = 69; // IGN \u2014 3-byte NOP that still reads from memory\n\n// \"Unstable\" opcodes whose output depends on the internal bus arbitration\n// between CPU cycles. Most store (register & (high byte of target + 1)).\n// The DMC audio channel's DMA transfer can hijack the bus mid-instruction\n// and change the stored value \u2014 the emulator handles this interaction in\n// the execute switch. Essentially no shipped games use these, but the\n// AccuracyCoin test ROM does.\nconst INS_SHA = 71; // SHA (AHX) \u2014 Store A & X & (H+1)\nconst INS_SHS = 72; // SHS (TAS) \u2014 SP = A & X, then store SP & (H+1)\nconst INS_SHY = 73; // SHY (SYA) \u2014 Store Y & (H+1)\nconst INS_SHX = 74; // SHX (SXA) \u2014 Store X & (H+1)\nconst INS_LAE = 75; // LAE (LAS) \u2014 A = X = SP = (memory & SP)\n\n// Opcodes whose behavior depends on a \"magic\" constant that varies between\n// CPU manufacturing runs (and even across die temperature). Tests only\n// exercise these with inputs (A = $FF, or immediate = $00) where the magic\n// value cancels out of the result, so we can pick any reasonable magic.\nconst INS_ANE = 76; // ANE (XAA) \u2014 A = (A | magic) & X & #imm\nconst INS_LXA = 77; // LXA (ATX) \u2014 A = X = (A | magic) & #imm\n\n// ----------------------------------------------------------------------------\n// The opcode table\n// ----------------------------------------------------------------------------\n//\n// OPCODE_TABLE is a plain object keyed by opcode byte. Every valid 6502\n// opcode has an entry here; unassigned bytes (including the KIL/STP/JAM\n// family that would hang a real CPU) are simply absent from the table.\n// The dispatch site in emulate() substitutes INVALID_OPCODE on lookup\n// miss, which has `ins: -1` \u2014 a value that matches no case in the\n// execute switch, so dispatch falls through to the default case and\n// throws a clear \"invalid opcode\" error.\n//\n// Using a shared INVALID_OPCODE object (rather than creating a fresh\n// one per lookup miss) means V8 sees a stable hidden class for both\n// valid and invalid lookups, which helps the JIT generate faster code\n// for the dispatch.\n//\n// Size and cycle counts come from the official 6502 datasheet and match\n// the nesdev wiki's tables at https://www.nesdev.org/wiki/CPU.\n//\n// The whole OPCODE_TABLE literal is marked `// prettier-ignore` so that\n// prettier doesn't collapse the manual column alignment below \u2014 being\n// able to scan straight down the \"mode\" column makes the table much\n// more readable than the default formatting would allow.\n\nconst INVALID_OPCODE = { ins: -1, mode: 0, size: 1, cycles: 2 };\n\n// prettier-ignore\nconst OPCODE_TABLE = {\n  // ADC \u2014 Add with carry\n  0x69: { ins: INS_ADC, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0x65: { ins: INS_ADC, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x75: { ins: INS_ADC, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0x6d: { ins: INS_ADC, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0x7d: { ins: INS_ADC, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0x79: { ins: INS_ADC, mode: ADDR_ABSY,       size: 3, cycles: 4 },\n  0x61: { ins: INS_ADC, mode: ADDR_PREIDXIND,  size: 2, cycles: 6 },\n  0x71: { ins: INS_ADC, mode: ADDR_POSTIDXIND, size: 2, cycles: 5 },\n\n  // AND \u2014 Bitwise AND with accumulator\n  0x29: { ins: INS_AND, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0x25: { ins: INS_AND, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x35: { ins: INS_AND, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0x2d: { ins: INS_AND, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0x3d: { ins: INS_AND, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0x39: { ins: INS_AND, mode: ADDR_ABSY,       size: 3, cycles: 4 },\n  0x21: { ins: INS_AND, mode: ADDR_PREIDXIND,  size: 2, cycles: 6 },\n  0x31: { ins: INS_AND, mode: ADDR_POSTIDXIND, size: 2, cycles: 5 },\n\n  // ASL \u2014 Arithmetic shift left\n  0x0a: { ins: INS_ASL, mode: ADDR_ACC,        size: 1, cycles: 2 },\n  0x06: { ins: INS_ASL, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0x16: { ins: INS_ASL, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0x0e: { ins: INS_ASL, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0x1e: { ins: INS_ASL, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // Branches \u2014 each tests a status flag and jumps relative to PC if it matches\n  0x90: { ins: INS_BCC, mode: ADDR_REL,        size: 2, cycles: 2 },\n  0xb0: { ins: INS_BCS, mode: ADDR_REL,        size: 2, cycles: 2 },\n  0xf0: { ins: INS_BEQ, mode: ADDR_REL,        size: 2, cycles: 2 },\n  0x30: { ins: INS_BMI, mode: ADDR_REL,        size: 2, cycles: 2 },\n  0xd0: { ins: INS_BNE, mode: ADDR_REL,        size: 2, cycles: 2 },\n  0x10: { ins: INS_BPL, mode: ADDR_REL,        size: 2, cycles: 2 },\n  0x50: { ins: INS_BVC, mode: ADDR_REL,        size: 2, cycles: 2 },\n  0x70: { ins: INS_BVS, mode: ADDR_REL,        size: 2, cycles: 2 },\n\n  // BIT \u2014 Test bits in memory against accumulator\n  0x24: { ins: INS_BIT, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x2c: { ins: INS_BIT, mode: ADDR_ABS,        size: 3, cycles: 4 },\n\n  // BRK \u2014 Software interrupt\n  0x00: { ins: INS_BRK, mode: ADDR_IMP,        size: 1, cycles: 7 },\n\n  // Flag clears\n  0x18: { ins: INS_CLC, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0xd8: { ins: INS_CLD, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0x58: { ins: INS_CLI, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0xb8: { ins: INS_CLV, mode: ADDR_IMP,        size: 1, cycles: 2 },\n\n  // CMP \u2014 Compare memory with accumulator (sets flags only)\n  0xc9: { ins: INS_CMP, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0xc5: { ins: INS_CMP, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0xd5: { ins: INS_CMP, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0xcd: { ins: INS_CMP, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0xdd: { ins: INS_CMP, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0xd9: { ins: INS_CMP, mode: ADDR_ABSY,       size: 3, cycles: 4 },\n  0xc1: { ins: INS_CMP, mode: ADDR_PREIDXIND,  size: 2, cycles: 6 },\n  0xd1: { ins: INS_CMP, mode: ADDR_POSTIDXIND, size: 2, cycles: 5 },\n\n  // CPX \u2014 Compare memory with X\n  0xe0: { ins: INS_CPX, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0xe4: { ins: INS_CPX, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0xec: { ins: INS_CPX, mode: ADDR_ABS,        size: 3, cycles: 4 },\n\n  // CPY \u2014 Compare memory with Y\n  0xc0: { ins: INS_CPY, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0xc4: { ins: INS_CPY, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0xcc: { ins: INS_CPY, mode: ADDR_ABS,        size: 3, cycles: 4 },\n\n  // DEC \u2014 Decrement memory by one\n  0xc6: { ins: INS_DEC, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0xd6: { ins: INS_DEC, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0xce: { ins: INS_DEC, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0xde: { ins: INS_DEC, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // DEX / DEY \u2014 Decrement X / Y by one\n  0xca: { ins: INS_DEX, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0x88: { ins: INS_DEY, mode: ADDR_IMP,        size: 1, cycles: 2 },\n\n  // EOR \u2014 Bitwise exclusive-OR with accumulator\n  0x49: { ins: INS_EOR, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0x45: { ins: INS_EOR, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x55: { ins: INS_EOR, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0x4d: { ins: INS_EOR, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0x5d: { ins: INS_EOR, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0x59: { ins: INS_EOR, mode: ADDR_ABSY,       size: 3, cycles: 4 },\n  0x41: { ins: INS_EOR, mode: ADDR_PREIDXIND,  size: 2, cycles: 6 },\n  0x51: { ins: INS_EOR, mode: ADDR_POSTIDXIND, size: 2, cycles: 5 },\n\n  // INC \u2014 Increment memory by one\n  0xe6: { ins: INS_INC, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0xf6: { ins: INS_INC, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0xee: { ins: INS_INC, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0xfe: { ins: INS_INC, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // INX / INY \u2014 Increment X / Y by one\n  0xe8: { ins: INS_INX, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0xc8: { ins: INS_INY, mode: ADDR_IMP,        size: 1, cycles: 2 },\n\n  // JMP \u2014 Unconditional jump (absolute or via indirect pointer)\n  0x4c: { ins: INS_JMP, mode: ADDR_ABS,        size: 3, cycles: 3 },\n  0x6c: { ins: INS_JMP, mode: ADDR_INDABS,     size: 3, cycles: 5 },\n\n  // JSR \u2014 Jump to subroutine (pushes return address first)\n  0x20: { ins: INS_JSR, mode: ADDR_ABS,        size: 3, cycles: 6 },\n\n  // LDA \u2014 Load accumulator from memory\n  0xa9: { ins: INS_LDA, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0xa5: { ins: INS_LDA, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0xb5: { ins: INS_LDA, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0xad: { ins: INS_LDA, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0xbd: { ins: INS_LDA, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0xb9: { ins: INS_LDA, mode: ADDR_ABSY,       size: 3, cycles: 4 },\n  0xa1: { ins: INS_LDA, mode: ADDR_PREIDXIND,  size: 2, cycles: 6 },\n  0xb1: { ins: INS_LDA, mode: ADDR_POSTIDXIND, size: 2, cycles: 5 },\n\n  // LDX \u2014 Load X from memory\n  0xa2: { ins: INS_LDX, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0xa6: { ins: INS_LDX, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0xb6: { ins: INS_LDX, mode: ADDR_ZPY,        size: 2, cycles: 4 },\n  0xae: { ins: INS_LDX, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0xbe: { ins: INS_LDX, mode: ADDR_ABSY,       size: 3, cycles: 4 },\n\n  // LDY \u2014 Load Y from memory\n  0xa0: { ins: INS_LDY, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0xa4: { ins: INS_LDY, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0xb4: { ins: INS_LDY, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0xac: { ins: INS_LDY, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0xbc: { ins: INS_LDY, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n\n  // LSR \u2014 Logical shift right\n  0x4a: { ins: INS_LSR, mode: ADDR_ACC,        size: 1, cycles: 2 },\n  0x46: { ins: INS_LSR, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0x56: { ins: INS_LSR, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0x4e: { ins: INS_LSR, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0x5e: { ins: INS_LSR, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // NOP \u2014 No operation. $EA is the official NOP; the other six bytes are\n  // unofficial single-byte NOPs that the 6502's decoder happens to treat\n  // identically, and we handle them the same way.\n  0x1a: { ins: INS_NOP, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0x3a: { ins: INS_NOP, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0x5a: { ins: INS_NOP, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0x7a: { ins: INS_NOP, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0xda: { ins: INS_NOP, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0xea: { ins: INS_NOP, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0xfa: { ins: INS_NOP, mode: ADDR_IMP,        size: 1, cycles: 2 },\n\n  // ORA \u2014 Bitwise OR with accumulator\n  0x09: { ins: INS_ORA, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0x05: { ins: INS_ORA, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x15: { ins: INS_ORA, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0x0d: { ins: INS_ORA, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0x1d: { ins: INS_ORA, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0x19: { ins: INS_ORA, mode: ADDR_ABSY,       size: 3, cycles: 4 },\n  0x01: { ins: INS_ORA, mode: ADDR_PREIDXIND,  size: 2, cycles: 6 },\n  0x11: { ins: INS_ORA, mode: ADDR_POSTIDXIND, size: 2, cycles: 5 },\n\n  // Stack pushes/pulls \u2014 PHA/PLA move the accumulator, PHP/PLP the status\n  // register. The 6502 stack lives in page 1 ($0100-$01FF), with SP as an\n  // offset into that page.\n  0x48: { ins: INS_PHA, mode: ADDR_IMP,        size: 1, cycles: 3 },\n  0x08: { ins: INS_PHP, mode: ADDR_IMP,        size: 1, cycles: 3 },\n  0x68: { ins: INS_PLA, mode: ADDR_IMP,        size: 1, cycles: 4 },\n  0x28: { ins: INS_PLP, mode: ADDR_IMP,        size: 1, cycles: 4 },\n\n  // ROL \u2014 Rotate left through carry\n  0x2a: { ins: INS_ROL, mode: ADDR_ACC,        size: 1, cycles: 2 },\n  0x26: { ins: INS_ROL, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0x36: { ins: INS_ROL, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0x2e: { ins: INS_ROL, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0x3e: { ins: INS_ROL, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // ROR \u2014 Rotate right through carry\n  0x6a: { ins: INS_ROR, mode: ADDR_ACC,        size: 1, cycles: 2 },\n  0x66: { ins: INS_ROR, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0x76: { ins: INS_ROR, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0x6e: { ins: INS_ROR, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0x7e: { ins: INS_ROR, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // RTI / RTS \u2014 Return from interrupt handler / subroutine\n  0x40: { ins: INS_RTI, mode: ADDR_IMP,        size: 1, cycles: 6 },\n  0x60: { ins: INS_RTS, mode: ADDR_IMP,        size: 1, cycles: 6 },\n\n  // SBC \u2014 Subtract memory from accumulator with borrow.\n  // $EB is an unofficial alternate opcode that the 6502's decoder treats\n  // identically to the official $E9 (immediate SBC).\n  0xe9: { ins: INS_SBC, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0xeb: { ins: INS_SBC, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0xe5: { ins: INS_SBC, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0xf5: { ins: INS_SBC, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0xed: { ins: INS_SBC, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0xfd: { ins: INS_SBC, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0xf9: { ins: INS_SBC, mode: ADDR_ABSY,       size: 3, cycles: 4 },\n  0xe1: { ins: INS_SBC, mode: ADDR_PREIDXIND,  size: 2, cycles: 6 },\n  0xf1: { ins: INS_SBC, mode: ADDR_POSTIDXIND, size: 2, cycles: 5 },\n\n  // Flag sets\n  0x38: { ins: INS_SEC, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0xf8: { ins: INS_SED, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0x78: { ins: INS_SEI, mode: ADDR_IMP,        size: 1, cycles: 2 },\n\n  // STA \u2014 Store accumulator to memory\n  0x85: { ins: INS_STA, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x95: { ins: INS_STA, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0x8d: { ins: INS_STA, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0x9d: { ins: INS_STA, mode: ADDR_ABSX,       size: 3, cycles: 5 },\n  0x99: { ins: INS_STA, mode: ADDR_ABSY,       size: 3, cycles: 5 },\n  0x81: { ins: INS_STA, mode: ADDR_PREIDXIND,  size: 2, cycles: 6 },\n  0x91: { ins: INS_STA, mode: ADDR_POSTIDXIND, size: 2, cycles: 6 },\n\n  // STX \u2014 Store X to memory\n  0x86: { ins: INS_STX, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x96: { ins: INS_STX, mode: ADDR_ZPY,        size: 2, cycles: 4 },\n  0x8e: { ins: INS_STX, mode: ADDR_ABS,        size: 3, cycles: 4 },\n\n  // STY \u2014 Store Y to memory\n  0x84: { ins: INS_STY, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x94: { ins: INS_STY, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0x8c: { ins: INS_STY, mode: ADDR_ABS,        size: 3, cycles: 4 },\n\n  // Register transfers \u2014 copy one register to another in a single cycle\n  0xaa: { ins: INS_TAX, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0xa8: { ins: INS_TAY, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0xba: { ins: INS_TSX, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0x8a: { ins: INS_TXA, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0x9a: { ins: INS_TXS, mode: ADDR_IMP,        size: 1, cycles: 2 },\n  0x98: { ins: INS_TYA, mode: ADDR_IMP,        size: 1, cycles: 2 },\n\n  // --- Unofficial opcodes ---\n  //\n  // These aren't part of the official 6502 spec but fall out of the chip's\n  // decoder logic. Nestest and AccuracyCoin exercise them, and a handful\n  // of shipped NES games rely on them. See the INS_* comments above for\n  // what each one actually computes.\n\n  // ALR (ASR) \u2014 AND then LSR\n  0x4b: { ins: INS_ALR, mode: ADDR_IMM,        size: 2, cycles: 2 },\n\n  // ANC \u2014 AND, with carry also set to bit 7 of the result\n  0x0b: { ins: INS_ANC, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0x2b: { ins: INS_ANC, mode: ADDR_IMM,        size: 2, cycles: 2 },\n\n  // ARR \u2014 AND then ROR (with quirky N/V/C flag behavior)\n  0x6b: { ins: INS_ARR, mode: ADDR_IMM,        size: 2, cycles: 2 },\n\n  // AXS (SBX) \u2014 X = (A & X) - immediate\n  0xcb: { ins: INS_AXS, mode: ADDR_IMM,        size: 2, cycles: 2 },\n\n  // LAX \u2014 Load A and X simultaneously from memory\n  0xa3: { ins: INS_LAX, mode: ADDR_PREIDXIND,  size: 2, cycles: 6 },\n  0xa7: { ins: INS_LAX, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0xaf: { ins: INS_LAX, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0xb3: { ins: INS_LAX, mode: ADDR_POSTIDXIND, size: 2, cycles: 5 },\n  0xb7: { ins: INS_LAX, mode: ADDR_ZPY,        size: 2, cycles: 4 },\n  0xbf: { ins: INS_LAX, mode: ADDR_ABSY,       size: 3, cycles: 4 },\n\n  // SAX \u2014 Store (A & X) to memory\n  0x83: { ins: INS_SAX, mode: ADDR_PREIDXIND,  size: 2, cycles: 6 },\n  0x87: { ins: INS_SAX, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x8f: { ins: INS_SAX, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0x97: { ins: INS_SAX, mode: ADDR_ZPY,        size: 2, cycles: 4 },\n\n  // DCP \u2014 DEC memory then CMP with A\n  0xc3: { ins: INS_DCP, mode: ADDR_PREIDXIND,  size: 2, cycles: 8 },\n  0xc7: { ins: INS_DCP, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0xcf: { ins: INS_DCP, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0xd3: { ins: INS_DCP, mode: ADDR_POSTIDXIND, size: 2, cycles: 8 },\n  0xd7: { ins: INS_DCP, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0xdb: { ins: INS_DCP, mode: ADDR_ABSY,       size: 3, cycles: 7 },\n  0xdf: { ins: INS_DCP, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // ISC (ISB) \u2014 INC memory then SBC from A\n  0xe3: { ins: INS_ISC, mode: ADDR_PREIDXIND,  size: 2, cycles: 8 },\n  0xe7: { ins: INS_ISC, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0xef: { ins: INS_ISC, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0xf3: { ins: INS_ISC, mode: ADDR_POSTIDXIND, size: 2, cycles: 8 },\n  0xf7: { ins: INS_ISC, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0xfb: { ins: INS_ISC, mode: ADDR_ABSY,       size: 3, cycles: 7 },\n  0xff: { ins: INS_ISC, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // RLA \u2014 ROL memory then AND with A\n  0x23: { ins: INS_RLA, mode: ADDR_PREIDXIND,  size: 2, cycles: 8 },\n  0x27: { ins: INS_RLA, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0x2f: { ins: INS_RLA, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0x33: { ins: INS_RLA, mode: ADDR_POSTIDXIND, size: 2, cycles: 8 },\n  0x37: { ins: INS_RLA, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0x3b: { ins: INS_RLA, mode: ADDR_ABSY,       size: 3, cycles: 7 },\n  0x3f: { ins: INS_RLA, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // RRA \u2014 ROR memory then ADC with A\n  0x63: { ins: INS_RRA, mode: ADDR_PREIDXIND,  size: 2, cycles: 8 },\n  0x67: { ins: INS_RRA, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0x6f: { ins: INS_RRA, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0x73: { ins: INS_RRA, mode: ADDR_POSTIDXIND, size: 2, cycles: 8 },\n  0x77: { ins: INS_RRA, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0x7b: { ins: INS_RRA, mode: ADDR_ABSY,       size: 3, cycles: 7 },\n  0x7f: { ins: INS_RRA, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // SLO \u2014 ASL memory then ORA with A\n  0x03: { ins: INS_SLO, mode: ADDR_PREIDXIND,  size: 2, cycles: 8 },\n  0x07: { ins: INS_SLO, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0x0f: { ins: INS_SLO, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0x13: { ins: INS_SLO, mode: ADDR_POSTIDXIND, size: 2, cycles: 8 },\n  0x17: { ins: INS_SLO, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0x1b: { ins: INS_SLO, mode: ADDR_ABSY,       size: 3, cycles: 7 },\n  0x1f: { ins: INS_SLO, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // SRE \u2014 LSR memory then EOR with A\n  0x43: { ins: INS_SRE, mode: ADDR_PREIDXIND,  size: 2, cycles: 8 },\n  0x47: { ins: INS_SRE, mode: ADDR_ZP,         size: 2, cycles: 5 },\n  0x4f: { ins: INS_SRE, mode: ADDR_ABS,        size: 3, cycles: 6 },\n  0x53: { ins: INS_SRE, mode: ADDR_POSTIDXIND, size: 2, cycles: 8 },\n  0x57: { ins: INS_SRE, mode: ADDR_ZPX,        size: 2, cycles: 6 },\n  0x5b: { ins: INS_SRE, mode: ADDR_ABSY,       size: 3, cycles: 7 },\n  0x5f: { ins: INS_SRE, mode: ADDR_ABSX,       size: 3, cycles: 7 },\n\n  // SKB \u2014 2-byte NOP that skips an immediate byte\n  0x80: { ins: INS_SKB, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0x82: { ins: INS_SKB, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0x89: { ins: INS_SKB, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0xc2: { ins: INS_SKB, mode: ADDR_IMM,        size: 2, cycles: 2 },\n  0xe2: { ins: INS_SKB, mode: ADDR_IMM,        size: 2, cycles: 2 },\n\n  // IGN \u2014 3-byte NOP that still performs a memory read\n  0x0c: { ins: INS_IGN, mode: ADDR_ABS,        size: 3, cycles: 4 },\n  0x1c: { ins: INS_IGN, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0x3c: { ins: INS_IGN, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0x5c: { ins: INS_IGN, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0x7c: { ins: INS_IGN, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0xdc: { ins: INS_IGN, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0xfc: { ins: INS_IGN, mode: ADDR_ABSX,       size: 3, cycles: 4 },\n  0x04: { ins: INS_IGN, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x44: { ins: INS_IGN, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x64: { ins: INS_IGN, mode: ADDR_ZP,         size: 2, cycles: 3 },\n  0x14: { ins: INS_IGN, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0x34: { ins: INS_IGN, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0x54: { ins: INS_IGN, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0x74: { ins: INS_IGN, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0xd4: { ins: INS_IGN, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n  0xf4: { ins: INS_IGN, mode: ADDR_ZPX,        size: 2, cycles: 4 },\n\n  // SHA (AHX) \u2014 Store A & X & (H+1)\n  0x93: { ins: INS_SHA, mode: ADDR_POSTIDXIND, size: 2, cycles: 6 },\n  0x9f: { ins: INS_SHA, mode: ADDR_ABSY,       size: 3, cycles: 5 },\n\n  // SHS (TAS) \u2014 SP = A & X, then store SP & (H+1)\n  0x9b: { ins: INS_SHS, mode: ADDR_ABSY,       size: 3, cycles: 5 },\n\n  // SHY (SYA) \u2014 Store Y & (H+1)\n  0x9c: { ins: INS_SHY, mode: ADDR_ABSX,       size: 3, cycles: 5 },\n\n  // SHX (SXA) \u2014 Store X & (H+1)\n  0x9e: { ins: INS_SHX, mode: ADDR_ABSY,       size: 3, cycles: 5 },\n\n  // LAE (LAS) \u2014 A = X = SP = memory & SP\n  0xbb: { ins: INS_LAE, mode: ADDR_ABSY,       size: 3, cycles: 4 },\n\n  // ANE (XAA) \u2014 A = (A | magic) & X & immediate\n  0x8b: { ins: INS_ANE, mode: ADDR_IMM,        size: 2, cycles: 2 },\n\n  // LXA \u2014 A = X = (A | magic) & immediate\n  0xab: { ins: INS_LXA, mode: ADDR_IMM,        size: 2, cycles: 2 },\n};\n\nclass CPU {\n  // IRQ Types\n  IRQ_NORMAL = 0;\n  IRQ_NMI = 1;\n  IRQ_RESET = 2;\n\n  constructor(nes) {\n    this.nes = nes;\n\n    // Main memory (Uint8Array is zero-initialized, so only need to set non-zero regions)\n    this.mem = new Uint8Array(0x10000);\n\n    this.mem.fill(0xff, 0, 0x2000);\n    for (let p = 0; p < 4; p++) {\n      let j = p * 0x800;\n      this.mem[j + 0x008] = 0xf7;\n      this.mem[j + 0x009] = 0xef;\n      this.mem[j + 0x00a] = 0xdf;\n      this.mem[j + 0x00f] = 0xbf;\n    }\n\n    // CPU Registers:\n    this.REG_ACC = 0;\n    this.REG_X = 0;\n    this.REG_Y = 0;\n    // Reset Stack pointer:\n    this.REG_SP = 0x01ff;\n    // Reset Program counter:\n    this.REG_PC = 0x8000 - 1;\n    this.REG_PC_NEW = 0x8000 - 1;\n    // Reset Status register:\n    this.REG_STATUS = 0x28;\n\n    this.setStatus(0x28);\n\n    // Set flags:\n    // Note: F_ZERO stores the result byte, not a boolean. When the result\n    // is 0, F_ZERO is 0 and the Z flag is considered set. Any non-zero\n    // value means the Z flag is clear. This avoids a comparison on every\n    // instruction that affects Z. All other flags are 0 or 1.\n    this.F_CARRY = 0;\n    this.F_DECIMAL = 0;\n    this.F_INTERRUPT = 1;\n    this.F_INTERRUPT_NEW = 1;\n    this.F_OVERFLOW = 0;\n    this.F_SIGN = 0;\n    this.F_ZERO = 1;\n\n    this.F_NOTUSED = 1;\n    this.F_NOTUSED_NEW = 1;\n    this.F_BRK = 1;\n    this.F_BRK_NEW = 1;\n\n    this.cyclesToHalt = 0;\n\n    // Reset crash flag:\n    this.crash = false;\n\n    // Interrupt notification:\n    this.irqRequested = false;\n    this.irqType = null;\n\n    // NMI edge-detection pipeline matching real 6502 timing.\n    // When the PPU's NMI output transitions low\u2192high, nmiRaised is set.\n    // The NMI delay depends on which PPU dot within the CPU cycle the edge\n    // occurs at: the edge detector samples at \u03c62 (end of cycle), and the\n    // internal signal goes high during \u03c61 of the NEXT cycle. The signal must\n    // be high by the instruction's final cycle for NMI to fire after it.\n    //\n    // In practice, this means:\n    // - VBL edge with >= 5 remaining PPU dots in the instruction: the edge\n    //   is detected early enough \u2192 NMI fires after this instruction (0-delay).\n    //   The frame loop sets nmiImmediate, and the next emulate() fires NMI\n    //   without executing an instruction first.\n    // - VBL edge with <= 4 remaining dots: the edge is in the last cycle \u2192\n    //   NMI fires after the NEXT instruction (1-delay). The frame loop sets\n    //   nmiPending, giving standard pipeline behavior.\n    // - $2000 write enabling NMI while VBL is active: the write always\n    //   happens on the last bus cycle, so nmiRaised\u2192nmiPending promotion\n    //   at the start of the next emulate() gives correct 1-delay.\n    //\n    // See https://www.nesdev.org/wiki/NMI and\n    // https://www.nesdev.org/wiki/CPU_interrupts\n    this.nmiRaised = false; // Set by _updateNmiOutput() on rising edge\n    this.nmiPending = false; // NMI fires at end of this emulate() call\n    this.nmiImmediate = false; // NMI fires at START of next emulate() (0-delay)\n\n    // Tracks the last value on the CPU data bus. When reading from unmapped\n    // addresses (\"open bus\"), the NES returns this value. Updated on every\n    // read, write, push, pull, and interrupt vector fetch.\n    // See https://www.nesdev.org/wiki/Open